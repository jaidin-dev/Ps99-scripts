local THEME = {
    Background = Color3.fromRGB(13, 15, 24),
    Surface = Color3.fromRGB(23, 27, 43),
    Accent = Color3.fromRGB(104, 92, 255),
    Text = Color3.fromRGB(241, 244, 255),
    Muted = Color3.fromRGB(157, 168, 198),
    Success = Color3.fromRGB(76, 220, 130),
}

local function addCorner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = obj
    return c
end

local function addStroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(88, 101, 242)
    s.Thickness = thickness or 1
    s.Parent = obj
    return s
end

