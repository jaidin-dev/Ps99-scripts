logLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
    logCard.Size = UDim2.new(1, 0, 0, math.max(200, logLabel.TextBounds.Y + 16))
end)

updateStateBanner()
updateStartButton()

local resumedFromTeleport = SESSION_ENV and SESSION_ENV.EQR_RESUMED_FROM_TELEPORT == true
local sessionMode = SESSION_ENV and SESSION_ENV.EQR_SESSION_MODE or nil

if SESSION_ENV then
    SESSION_ENV.EQR_RESUMED_FROM_TELEPORT = nil
end

local MODE_SELECTED = isValidMode(sessionMode)
if MODE_SELECTED then
    CONFIG.MODE = sessionMode
else
    CONFIG.RUNNING = false
end

local function activateSelectedMode(mode, resumeReason)
    CONFIG.MODE = mode
    rememberSessionMode(mode)
    MODE_SELECTED = true
    CONFIG.RUNNING = true

    if CONFIG.MODE == "QUEST" then
        LAST_QUEST_SHOP_VISIT = os.clock()
    end

    if GUI_REF.modePill then
        GUI_REF.modePill.Text = CONFIG.MODE
        GUI_REF.modePill.BackgroundColor3 = CONFIG.MODE == "HUGE"
            and Color3.fromRGB(102, 73, 181)
            or Color3.fromRGB(38, 126, 92)
    end

    updateStartButton()
    updateStateBanner()
    setStage(CONFIG.MODE, resumeReason or (CONFIG.MODE .. " mode started"))
    addLog(resumeReason or ("Mode selected: " .. CONFIG.MODE))

    task.defer(function()
        task.wait(0.2)
        if setCollapsed then setCollapsed(true) end
    end)
end

local function createModeSelector()
    local existingSelector = playerGui:FindFirstChild("ModeSelector")
    if existingSelector then
        existingSelector:Destroy()
    end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ModeSelector"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = playerGui

    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.BackgroundColor3 = Color3.fromRGB(4, 6, 12)
    overlay.BackgroundTransparency = 0.28
    overlay.BorderSizePixel = 0
    overlay.Parent = screenGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(mobile and 320 or 390, mobile and 250 or 270)
    frame.Position = UDim2.new(0.5, mobile and -160 or -195, 0.5, mobile and -125 or -135)
    frame.BackgroundColor3 = Color3.fromRGB(19, 22, 35)
    frame.BorderSizePixel = 0
    frame.Parent = overlay
    addCorner(frame, 16)
    addStroke(frame, THEME.Accent, 1.5)

    local selectorGradient = Instance.new("UIGradient")
    selectorGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 34, 55)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 18, 29)),
    })
    selectorGradient.Rotation = 90
    selectorGradient.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -32, 0, 34)
    title.Position = UDim2.fromOffset(16, 14)
    title.BackgroundTransparency = 1
    title.Text = "Choose your run mode"
    title.TextColor3 = THEME.Text
    title.TextSize = mobile and 17 or 20
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local subtitle = Instance.new("TextLabel")
    subtitle.Size = UDim2.new(1, -32, 0, 34)
    subtitle.Position = UDim2.fromOffset(16, 46)
    subtitle.BackgroundTransparency = 1
    subtitle.Text = "The runner starts immediately and minimizes after selection."
    subtitle.TextColor3 = THEME.Muted
    subtitle.TextSize = FS - 1
    subtitle.Font = Enum.Font.Gotham
    subtitle.TextWrapped = true
    subtitle.TextXAlignment = Enum.TextXAlignment.Left
    subtitle.Parent = frame

    local function makeModeButton(y, titleText, descriptionText, color)
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, -32, 0, mobile and 66 or 72)
        button.Position = UDim2.fromOffset(16, y)
        button.BackgroundColor3 = Color3.fromRGB(28, 33, 52)
        button.BorderSizePixel = 0
        button.Text = ""
        button.AutoButtonColor = true
        button.Parent = frame
        addCorner(button, 10)
        addStroke(button, color, 1.2)

        local stripe = Instance.new("Frame")
        stripe.Size = UDim2.fromOffset(4, mobile and 42 or 48)
        stripe.Position = UDim2.fromOffset(10, mobile and 12 or 12)
        stripe.BackgroundColor3 = color
        stripe.BorderSizePixel = 0
        stripe.Parent = button
        addCorner(stripe, 2)

        local buttonTitle = Instance.new("TextLabel")
        buttonTitle.Size = UDim2.new(1, -34, 0, 24)
        buttonTitle.Position = UDim2.fromOffset(24, 9)
        buttonTitle.BackgroundTransparency = 1
        buttonTitle.Text = titleText
        buttonTitle.TextColor3 = THEME.Text
        buttonTitle.Font = Enum.Font.GothamBold
        buttonTitle.TextSize = FS + 1
        buttonTitle.TextXAlignment = Enum.TextXAlignment.Left
        buttonTitle.Parent = button

        local description = Instance.new("TextLabel")
        description.Size = UDim2.new(1, -34, 0, mobile and 27 or 32)
        description.Position = UDim2.fromOffset(24, 32)
        description.BackgroundTransparency = 1
        description.Text = descriptionText
        description.TextColor3 = THEME.Muted
        description.Font = Enum.Font.Gotham
        description.TextSize = FS - 1
        description.TextWrapped = true
        description.TextXAlignment = Enum.TextXAlignment.Left
        description.TextYAlignment = Enum.TextYAlignment.Top
        description.Parent = button

        return button
    end

    local questBtn = makeModeButton(
        mobile and 88 or 92,
        "Quest Mode",
        "Stay in one server, buy cubes, finish quests, break the chest and reroll pets.",
        Color3.fromRGB(66, 205, 132)
    )

    local hugeBtn = makeModeButton(
        mobile and 162 or 172,
        "Huge Mode",
        "Buy stock, break the chest, check for a Huge, then move to a fresh server.",
        THEME.Accent
    )

    questBtn.MouseButton1Click:Connect(function()
        screenGui:Destroy()
        activateSelectedMode("QUEST", "Quest mode started")
    end)

    hugeBtn.MouseButton1Click:Connect(function()
        screenGui:Destroy()
        activateSelectedMode("HUGE", "Huge mode started")
    end)

    return screenGui
end

if not MODE_SELECTED then
    createModeSelector()

    while not MODE_SELECTED do
        task.wait(0.1)
    end
else
    activateSelectedMode(
        CONFIG.MODE,
        resumedFromTeleport
            and ("Resumed " .. CONFIG.MODE .. " after server hop")
            or ("Resumed " .. CONFIG.MODE .. " for this Roblox session")
    )
end

if updateServerHistoryUI then updateServerHistoryUI() end

task.spawn(function()
    while gui.Parent do
        if CONFIG.AUTO_FRUITS and CONFIG.RUNNING then
            pcall(autoEatFruits)
        end
        task.wait(5)
    end
end)

task.spawn(function()
    while gui.Parent do
        if CONFIG.AUTO_BREAK and CONFIG.RUNNING then
            pcall(autoBreakChests)
        end
        task.wait(0.25)
    end
end)

GUI_REF.startRuntime = function()
local function seedKnownPetInventory()
    local count = 0
    local counted = {}
    local readyDeadline = os.clock() + 8

    local function snapshotCurrentPets()
        local data = Save and Save.Get()
        local inventory = data and data.Inventory
        local petInv = inventory and inventory.Pet

        if type(petInv) ~= "table" then
            return false
        end

        for uuid in pairs(petInv) do
            KNOWN_PET_UUIDS[uuid] = true
            if not counted[uuid] then
                counted[uuid] = true
                count = count + 1
            end
        end

        return true
    end

    while not snapshotCurrentPets() and os.clock() < readyDeadline do
        task.wait(0.25)
    end

    -- A second pass catches inventory entries that arrive just after Save.Get()
    -- first exposes the Pet table, preventing old pets from being called new.
    task.wait(2)
    snapshotCurrentPets()

    addLog("Inventory baseline saved: " .. tostring(count) .. " existing pets ignored")
end

pcall(seedKnownPetInventory)

task.spawn(function()
    while gui.Parent do
        pcall(function()
            local data = Save and Save.Get()
            local petInv = data and data.Inventory and data.Inventory.Pet or {}

            for uuid, petData in pairs(petInv) do
                if type(petData) == "table" and not KNOWN_PET_UUIDS[uuid] then
                    KNOWN_PET_UUIDS[uuid] = true
                    local isHuge, petId = isHugeInventoryPet(petData)

                    if isHuge then
                        local displayName = petId ~= "" and petId or "Unknown Huge"
                        addLog("New Huge entered inventory: " .. displayName)

                        -- Give the active catch routine a moment to claim this UUID.
                        -- That prevents duplicate 'caught' and 'inventory' alerts.
                        task.delay(1.25, function()
                            if gui.Parent and not CAUGHT_RARE_UUIDS[uuid] and CONFIG.ALERT_RARE then
                                sendWebhookReliable(
                                    "NEW HUGE IN INVENTORY!",
                                    "A new **" .. tostring(displayName) .. "** appeared in your inventory.",
                                    WEBHOOK_COLORS.GOLD,
                                    {
                                        { name = "Pet", value = tostring(displayName), inline = true },
                                        { name = "Player", value = player.Name, inline = true },
                                        { name = "Mode", value = CONFIG.MODE, inline = true },
                                        { name = "Runtime", value = getFormattedRuntime(), inline = true },
                                    }
                                )
                            end
                        end)
                    end
                end
            end
        end)

        task.wait(0.5)
    end
end)

task.spawn(function()
    local lastAlertTime = 0
    while gui.Parent do
        if CONFIG.ALERT_LOW_CUBES then
            local cubes = getCubeCount()
            if cubes <= CONFIG.CUBE_ALERT_THRESHOLD and (os.time() - lastAlertTime) > 300 then
                lastAlertTime = os.time()
                addLog("Low cubes: " .. cubes .. " (alert at " .. CONFIG.CUBE_ALERT_THRESHOLD .. ")")
                sendWebhook(
                    "Low Cubes",
                    string.format("**%d** %s left (alert: %d)", cubes, getCubeName(), CONFIG.CUBE_ALERT_THRESHOLD),
                    WEBHOOK_COLORS.ORANGE,
                    {
                        { name = "Current Count", value = tostring(cubes), inline = true },
                        { name = "Threshold", value = tostring(CONFIG.CUBE_ALERT_THRESHOLD), inline = true },
                        { name = "Auto Buy", value = CONFIG.AUTO_RESTOCK and "ON" or "OFF", inline = true },
                    }
                )
            end
        end
        task.wait(30)
    end
end)

task.spawn(function()
    while gui.Parent do
        pcall(function()
            renderGoals()
            updateStatsTab()
            if GUI_REF.quickStatsLabel then
                GUI_REF.quickStatsLabel.Text = string.format(
                    "%s | %d Servers | %d Caught | %d Cubes",
                    getFormattedRuntime(), #SERVER_HISTORY, STATS.PetsCaught, getCubeCount()
                )
            end
            if GUI_REF.cubeInfoLabel then
                GUI_REF.cubeInfoLabel.Text = string.format(
                    "Normal: %d | Ultra: %d | Using: %s",
                    getCubeCount(false), getCubeCount(true), getCubeName()
                )
            end
        end)

        if (os.time() - LAST_CUBE_CHECK_TIME) >= CUBE_CHECK_INTERVAL then
            LAST_CUBE_CHECK_TIME = os.time()
            sendInventoryAlert()
        end
        if (os.time() - LAST_SUMMARY_TIME) >= SUMMARY_INTERVAL then
            sendSummaryDigest(false)
        end

        task.wait(1)
    end
end)

local function goToElementalRealm()
    local alreadyThere = false

    pcall(function()
        alreadyThere = MapCmds
            and MapCmds.GetCurrentZone
            and MapCmds.GetCurrentZone() == "Elemental Realm"
    end)

    if alreadyThere then
        return true
    end

    if setStage then setStage("TRAVEL", "Going to Elemental Realm") else setStatus("Going to Elemental Realm") end

    local teleported = false
    pcall(function()
        if MapCmds and MapCmds.Teleport then
            MapCmds.Teleport("Elemental Realm")
            teleported = true
        end
    end)

    if not teleported then
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = ELEMENTAL_REALM_CFRAME
            teleported = true
        end
    end

    task.wait(1.5)
    return teleported
end

local function holdPlayerAt(targetCFrame)
    local root = getRootPart()
    if not root or not targetCFrame then
        return false
    end

    if (root.Position - targetCFrame.Position).Magnitude > 3 then
        root.CFrame = targetCFrame
    end

    return true
end

local function waitForBossChest(timeoutSeconds)
    local deadline = os.clock() + math.max(0.5, tonumber(timeoutSeconds) or CHEST_LOAD_TIMEOUT)

    repeat
        holdPlayerAt(BOSS_CHEST_CFRAME)

        local bossChest = checkForBossChest()
        if bossChest and bossChest.Parent then
            return bossChest
        end

        local remaining = math.max(0, deadline - os.clock())
        if setStage then
            setStage("CHEST", string.format("Waiting for chest to load â€¢ %.1fs", remaining))
        else
            setStatus(string.format("Waiting for boss chest (%.1fs)", remaining))
        end
        task.wait(math.min(0.25, remaining))
    until os.clock() >= deadline or not CONFIG.RUNNING

    return checkForBossChest()
end

local function activateBossChest(bossChest)
    if not bossChest or not bossChest.Parent then
        return false
    end

    local activated = false

    -- Use the chest's normal interaction objects when the environment exposes them.
    for _, object in ipairs(bossChest:GetDescendants()) do
        if object:IsA("ClickDetector") and fireclickdetector then
            local ok = pcall(function()
                fireclickdetector(object)
            end)
            activated = activated or ok
        elseif object:IsA("ProximityPrompt") and fireproximityprompt then
            local ok = pcall(function()
                fireproximityprompt(object)
            end)
            activated = activated or ok
        end
    end

    -- Also perform the same screen click a player would use to target the
    -- chest. This covers chests that do not expose a ClickDetector.
    local camera = workspace.CurrentCamera
    if camera then
        local clickOk = pcall(function()
            local chestPosition = bossChest:GetPivot().Position
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, chestPosition)
            task.wait()

            local screenPoint = camera:WorldToViewportPoint(chestPosition)
            if screenPoint.Z > 0 then
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(screenPoint.X, screenPoint.Y))
            end
        end)
        activated = activated or clickOk
    end

    return activated
end

local function breakBossChest(bossChest)
    if not bossChest or not bossChest.Parent then
        return false
    end

    local net = game:GetService("ReplicatedStorage"):FindFirstChild("Network")
    local damageRemote = net and net:FindFirstChild("Breakables_PlayerDealDamage")
    local setTargetBulk = net and net:FindFirstChild("Pets_SetTargetBulk")

    if not damageRemote then
        addLog("Cannot break boss chest: damage remote missing")
        return false
    end

    if not movePlayer(BOSS_CHEST_CFRAME, "Going to boss chest") then
        return false
    end

    -- Give the chest and its interaction descendants time to stream in.
    task.wait(0.75)
    bossChest = checkForBossChest() or bossChest

    if not bossChest or not bossChest.Parent then
        addLog("Boss chest disappeared before interaction")
        return false
    end

    addLog("Boss chest found; clicking and assigning pets")
    if setStage then setStage("CHEST", "Breaking boss chest") else setStatus("Breaking boss chest") end

    local started = os.clock()
    local goneSince = nil
    local lastInteraction = -math.huge
    local lastPetTarget = -math.huge

    -- Watch the actual chest instance. A temporary missed scan is not enough
    -- to start the Huge timer; the instance must be destroyed/removed and no
    -- replacement chest may be visible at the spawn for the confirmation window.
    local watchedChest = nil
    local chestDestroyed = false
    local destroyConnection = nil
    local ancestryConnection = nil

    local function disconnectChestWatch()
        if destroyConnection then
            destroyConnection:Disconnect()
            destroyConnection = nil
        end
        if ancestryConnection then
            ancestryConnection:Disconnect()
            ancestryConnection = nil
        end
    end

    local function watchChest(chest)
        if not chest or watchedChest == chest then
            return
        end

        disconnectChestWatch()
        watchedChest = chest
        chestDestroyed = false

        pcall(function()
            destroyConnection = chest.Destroying:Connect(function()
                chestDestroyed = true
            end)
        end)

        pcall(function()
            ancestryConnection = chest.AncestryChanged:Connect(function(_, parent)
                if parent == nil or not chest:IsDescendantOf(workspace) then
                    chestDestroyed = true
                end
            end)
        end)
    end

    watchChest(bossChest)

    while CONFIG.RUNNING and os.clock() - started < CHEST_BREAK_TIMEOUT do
        holdPlayerAt(BOSS_CHEST_CFRAME)

        local currentChest = checkForBossChest()
        if currentChest and currentChest.Parent then
            bossChest = currentChest
            watchChest(currentChest)
            goneSince = nil

            local now = os.clock()

            -- Re-click periodically in case the first interaction happened before streaming finished.
            if now - lastInteraction >= 0.5 then
                activateBossChest(bossChest)
                lastInteraction = now
            end

            pcall(function()
                damageRemote:FireServer(bossChest.Name)
            end)

            if setTargetBulk and now - lastPetTarget >= 0.35 then
                local data = Save and Save.Get()
                local equippedPets = data and data.EquippedPets or {}
                local petTargets = {}

                for petUid in pairs(equippedPets) do
                    petTargets[petUid] = bossChest.Name
                end

                if next(petTargets) then
                    pcall(function()
                        setTargetBulk:FireServer(petTargets)
                    end)
                end

                lastPetTarget = now
            end
        else
            local exactChestGone = chestDestroyed
                or not watchedChest
                or not watchedChest.Parent
                or not watchedChest:IsDescendantOf(workspace)

            if exactChestGone then
                goneSince = goneSince or os.clock()
            else
                -- The scan flickered, but the watched chest still exists.
                goneSince = nil
            end

            local elapsed = os.clock() - started
            local goneLongEnough = goneSince
                and (os.clock() - goneSince >= CHEST_GONE_CONFIRM_TIME)

            if exactChestGone
                and elapsed >= CHEST_MIN_DWELL_TIME
                and goneLongEnough
                and not checkForBossChest() then

                disconnectChestWatch()
                STATS.ChestsBroken = STATS.ChestsBroken + 1
                addLog("Boss chest break confirmed")

                -- Move onto the loot first. The three-second Huge timer is only
                -- started by waitForHuge() after this function returns true.
                movePlayer(BOSS_CHEST_LOOT_CFRAME, "Collecting boss chest loot")
                return true
            end
        end

        local elapsed = os.clock() - started
        setStatus(string.format("Breaking boss chest (%.1fs)", elapsed))
        task.wait(0.1)
    end

    disconnectChestWatch()

    if checkForBossChest() then
        addLog("Boss chest still active after break timeout")
        setStatus("Chest still active - retrying")
    else
        addLog("Chest disappearance was not confirmed; staying in server")
        setStatus("Chest result unclear - retrying")
    end

    return false
end

local function getHugeSpawnKey(index, petId)
    return tostring(game.JobId) .. ":" .. tostring(index) .. ":" .. tostring(petId)
end

local function alertHugeSpawn(index, petId, rareType)
    local key = getHugeSpawnKey(index, petId)
    if ALERTED_HUGE_SPAWNS[key] then
        return true
    end
    ALERTED_HUGE_SPAWNS[key] = true

    addLog("NEW HUGE SPAWN DETECTED: " .. tostring(petId))
    if setStage then setStage("HUGE FOUND", "Sending Discord alert and starting catch") end

    local title = (rareType or "HUGE") .. " SPAWNED!"
    local description = "A new **" .. tostring(petId) .. "** spawned after the chest break."
    local fields = {
        { name = "Pet", value = tostring(petId), inline = true },
        { name = "Player", value = player.Name, inline = true },
        { name = "Server", value = string.sub(game.JobId, 1, 12), inline = true },
        { name = "Mode", value = CONFIG.MODE, inline = true },
    }

    -- Make one immediate request, then retry asynchronously so catching is not
    -- delayed by a slow or temporarily failing Discord request.
    local success, status = sendWebhook(title, description, WEBHOOK_COLORS.RED, fields)
    if success then
        addLog("Huge spawn webhook delivered")
        return true
    end

    addLog("Initial Huge webhook failed: " .. tostring(status) .. "; retrying")
    task.spawn(function()
        local retrySuccess, retryStatus = sendWebhookReliable(
            title,
            description,
            WEBHOOK_COLORS.RED,
            fields
        )

        if retrySuccess then
            addLog("Huge spawn webhook delivered by retry")
        else
            addLog("Huge spawn webhook failed after retries: " .. tostring(retryStatus))
        end
    end)

    return false
end

local function snapshotPetUUIDs()
    local known = {}
    local data = Save and Save.Get()
    local petInv = data and data.Inventory and data.Inventory.Pet or {}
    for uuid in pairs(petInv) do
        known[uuid] = true
    end
    return known
end

local function targetStillRoaming(index, petId)
    local data = Save and Save.Get()
    local roaming = data and data.RoamingPets or {}
    local entry = roaming[index]
    return entry ~= nil and getRoamingPetId(entry) == petId
end

local function confirmCatchResult(beforeUUIDs, index, petId, requireHuge)
    local deadline = os.clock() + CATCH_CONFIRM_TIMEOUT
    local disappeared = false

    repeat
        local data = Save and Save.Get()
        local petInv = data and data.Inventory and data.Inventory.Pet or {}

        for uuid, petData in pairs(petInv) do
            if not beforeUUIDs[uuid] and type(petData) == "table" then
                local newPetId = tostring(petData.id or "")
                local isHuge = isHugeInventoryPet(petData)
                local idMatches = newPetId == tostring(petId)

                if idMatches or (requireHuge and isHuge) then
                    KNOWN_PET_UUIDS[uuid] = true
                    return "CAUGHT", uuid, newPetId
                end
            end
        end

        if not targetStillRoaming(index, petId) then
            disappeared = true
        end

        task.wait(0.15)
    until os.clock() >= deadline or not CONFIG.RUNNING

    if disappeared then
        return "ESCAPED"
    end

    return "UNCONFIRMED"
end

local function waitForHuge(seconds)
    local waitSeconds = math.max(0.25, tonumber(seconds) or HUGE_SPAWN_WAIT)
    local deadline = os.clock() + waitSeconds

    addLog(string.format("Chest confirmed broken; starting %.1f-second Huge timer", waitSeconds))

    repeat
        holdPlayerAt(BOSS_CHEST_LOOT_CFRAME)

        local hugeIndex, hugePetId, hugeIsRare, hugeRareType = findRarePetOnly()

        if hugeIndex and hugeIsRare then
            addLog("Huge pet found: " .. tostring(hugePetId))
            alertHugeSpawn(hugeIndex, hugePetId, hugeRareType)
            return hugeIndex, hugePetId, hugeIsRare, hugeRareType
        end

        local remaining = math.max(0, deadline - os.clock())
        if setStage then
            setStage("HUGE CHECK", string.format("Watching chest loot â€¢ %.1fs", remaining))
        else
            setStatus(string.format("Waiting for huge spawn (%.1fs)", remaining))
        end
        task.wait(math.min(0.2, remaining))
    until os.clock() >= deadline or not CONFIG.RUNNING

    return findRarePetOnly()
end

task.spawn(function()
    while gui.Parent do
        if not CONFIG.RUNNING then
            setStatus("Paused")
            task.wait(0.5)
            continue
        end

        goToElementalRealm()

        local index, petId, isRareTarget, rareType

        if CONFIG.MODE == "HUGE" then
            -- One shop visit per joined server, then chest -> loot -> 3-second huge check.
            if not HUGE_SERVER_SHOP_DONE then
                visitShopAndBuy(nil)
                HUGE_SERVER_SHOP_DONE = true
            end

            movePlayer(BOSS_CHEST_CFRAME, "Going to boss chest")
            local bossChest = waitForBossChest(CHEST_LOAD_TIMEOUT)

            if not bossChest then
                -- A huge may already be roaming even if this server's chest is gone.
                index, petId, isRareTarget, rareType = findRarePetOnly()

                if not index then
                    addLog("No boss chest appeared within " .. CHEST_LOAD_TIMEOUT .. " seconds")
                    setStatus("No chest or huge - hopping")
                    pcall(serverHop)
                    task.wait(5)
                    continue
                end
            else
                if not breakBossChest(bossChest) then
                    -- Never hop just because the chest lookup flickered or the
                    -- break attempt timed out. Stay here and retry it.
                    task.wait(1)
                    continue
                end

                index, petId, isRareTarget, rareType = waitForHuge(HUGE_SPAWN_WAIT)

                if not index then
                    addLog("No huge spawned after " .. HUGE_SPAWN_WAIT .. " seconds - hopping")
                    setStatus("No huge - hopping")
                    pcall(serverHop)
                    task.wait(5)
                    continue
                end
            end
        else
            -- QUEST MODE NEVER SERVER HOPS.
            -- Every 30 seconds it visits the shop, buys stock, and returns to farm.
            if CONFIG.AUTO_RESTOCK
                and (os.clock() - LAST_QUEST_SHOP_VISIT) >= QUEST_SHOP_INTERVAL then

                LAST_QUEST_SHOP_VISIT = os.clock()
                visitShopAndBuy(FARM_ZONE_CFRAME)
            end

            local bossChest = CONFIG.AUTO_BREAK and checkForBossChest() or nil
            if bossChest and breakBossChest(bossChest) then
                index, petId, isRareTarget, rareType = waitForHuge(HUGE_SPAWN_WAIT)
            end

            if not index then
                if not ensureQuestData() then
                    setStatus("Getting quest data")
                    task.wait(1)
                    continue
                end

                if questComplete() then
                    setStatus("Quest done, claiming reward")
                    redeem()
                    task.wait(2)
                    continue
                end

                index, petId, isRareTarget, rareType = chooseTarget()
            end

            if not index then
                local rerollIndex, rerollPetId = findHighestChancePet()

                if rerollIndex then
                    index = rerollIndex
                    petId = rerollPetId
                    isRareTarget = false
                    rareType = "REROLL"
                    addLog("Quest pet unavailable; rerolling " .. tostring(rerollPetId))
                    setStatus("Rerolling pets for quest target")
                else
                    addLog("No roaming pets available; staying in this server")
                    setStatus("No pets available - waiting in server")
                    task.wait(3)
                    continue
                end
            end
        end

        if not index then
            task.wait(1)
            continue
        end

        local targetCubeName = "Pet Cube"

        if isRareTarget then
            local ultraCount = getCubeCount(true)
            local normalCount = getCubeCount(false)

            if ultraCount > 0 then
                targetCubeName = "Ultra Pet Cube"
                addLog("Using Ultra cubes for rare pet (" .. ultraCount .. " available)")
            else
                addLog("Using Normal cubes for rare pet (" .. normalCount .. " available, no ultra)")
            end
        elseif CONFIG.USE_ULTRA and getCubeCount(true) > 0 then
            targetCubeName = "Ultra Pet Cube"
        end

        local cubeCount = getCubeCount(targetCubeName == "Ultra Pet Cube")

        if cubeCount < 1 then
            setStatus("Out of " .. targetCubeName .. "s - waiting for restock...")
            task.wait(2)
            continue
        end

        if isRareTarget and rareType then
            if setStage then
                setStage(
                    "CATCHING HUGE",
                    tostring(petId) .. " with " .. targetCubeName .. " (" .. cubeCount .. " left)"
                )
            else
                setStatus(rareType .. " PET: " .. tostring(petId) .. "! Throwing " .. targetCubeName .. "...")
            end
            alertHugeSpawn(index, petId, rareType)
            addLog(rareType .. " PET: " .. tostring(petId))
        elseif rareType == "REROLL" then
            setStatus("Rerolling " .. tostring(petId) .. " for new spawns...")
        else
            setStatus("Throwing " .. targetCubeName .. " at " .. tostring(petId) .. " (" .. cubeCount .. " left)")
        end

        -- Rare pets can reject the catch request when the player is too far away.
        -- Move directly to the matching roaming-pet model before throwing a cube.
        if isRareTarget then
            local movedToTarget = false

            local moveOk, moveErr = pcall(function()
                local things = workspace:FindFirstChild("__THINGS")
                local roamingFolder = things and things:FindFirstChild("RoamingPets")

                if not roamingFolder then
                    return
                end

                for _, model in ipairs(roamingFolder:GetChildren()) do
                    if model.Name == tostring(index) and model:IsA("Model") then
                        local character = player.Character
                        local root = character and character:FindFirstChild("HumanoidRootPart")

                        if root then
                            root.CFrame = model:GetPivot()
                            movedToTarget = true
                            addLog("Moved to huge pet model before catch: " .. tostring(index))
                            task.wait(0.25)
                        end

                        break
                    end
                end
            end)

            if not moveOk then
                addLog("Huge proximity move failed: " .. tostring(moveErr))
            elseif not movedToTarget then
                addLog("Could not find roaming-pet model for index " .. tostring(index))
            end
        end

        local beforePetUUIDs = snapshotPetUUIDs()
        local ok, accepted = pcall(function()
            return ClientNetwork.Invoke("RoamingPets_CatchPet", targetCubeName, index)
        end)

        if isRareTarget
            and targetCubeName == "Ultra Pet Cube"
            and (not ok or not accepted)
            and getCubeCount(false) > 0 then

            addLog("Ultra catch unavailable; falling back to a normal Pet Cube")
            targetCubeName = "Pet Cube"
            cubeCount = getCubeCount(false)
            ok, accepted = pcall(function()
                return ClientNetwork.Invoke("RoamingPets_CatchPet", targetCubeName, index)
            end)
        end

        if ok and accepted then
            STATS.CubesSpent = STATS.CubesSpent + 1
            if setStage then setStage("VERIFYING CATCH", "Checking inventory and roaming-pet state") end

            local result, newUuid = confirmCatchResult(
                beforePetUUIDs,
                index,
                petId,
                isRareTarget == true
            )

            if result == "CAUGHT" then
                STATS.PetsCaught = STATS.PetsCaught + 1
                local catchMsg = (isRareTarget and "CAUGHT " .. (rareType or "HUGE") .. " PET: " or "Caught ") .. tostring(petId)
                addLog(catchMsg)
                setStatus(catchMsg)

                if newUuid then
                    KNOWN_PET_UUIDS[newUuid] = true
                end

                if isRareTarget then
                    STATS.RareCatches = STATS.RareCatches + 1
                    if newUuid then
                        CAUGHT_RARE_UUIDS[newUuid] = true
                    end

                    sendWebhookReliable(
                        (rareType or "HUGE") .. " PET CAUGHT!",
                        "Inventory confirmation received for **" .. tostring(petId) .. "**.",
                        WEBHOOK_COLORS.GOLD,
                        {
                            { name = "Pet", value = tostring(petId), inline = true },
                            { name = "Cube", value = targetCubeName, inline = true },
                            { name = "Player", value = player.Name, inline = true },
                            { name = "Runtime", value = getFormattedRuntime(), inline = true },
                        }
                    )
                elseif rareType == "REROLL" then
                    addLog("Rerolled " .. tostring(petId))
                end
            elseif result == "ESCAPED" then
                STATS.PetsEscaped = STATS.PetsEscaped + 1
                setStatus(tostring(petId) .. " left the roaming list without entering inventory")
                addLog("Catch not confirmed; target disappeared: " .. tostring(petId))
            else
                setStatus("Catch result unconfirmed - retrying if the pet remains")
                addLog("Catch result unconfirmed for " .. tostring(petId))
            end
        else
            setStatus("Catch request failed - retrying...")
            addLog("Catch remote rejected for " .. tostring(petId))
        end

        task.wait(CATCH_DELAY)
    end
end)

addLog("Elemental Quest Runner " .. VERSION .. " loaded!")
addLog("Config: " .. (CONFIG.USE_ULTRA and "Ultra" or "Normal") .. " cubes | Auto-Buy: " .. (CONFIG.AUTO_RESTOCK and "ON" or "OFF"))
if CONFIG.RUNNING then
    setStage(CONFIG.MODE, CONFIG.MODE .. " mode active")
else
    setStatus("Choose a mode to begin")
end
sendInventoryAlert()

print("[EQR " .. VERSION .. "] Professional Edition loaded successfully!")
end

GUI_REF.startRuntime()