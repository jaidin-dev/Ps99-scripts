local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Library = ReplicatedStorage:WaitForChild("Library", 10)

if not Library then
    warn("[EQR] Library not found, stopping")
    return
end

local function safeRequire(path)
    local ok, result = pcall(require, path)
    return ok and result or nil
end

local Save = safeRequire(Library.Client:WaitForChild("Save"))
local ClientNetwork = safeRequire(Library.Client:WaitForChild("Network"))
local MapCmds = safeRequire(Library.Client:WaitForChild("MapCmds"))
local Directory = safeRequire(Library.Directory)
local FruitCmds = Library.Client:FindFirstChild("FruitCmds") and safeRequire(Library.Client.FruitCmds) or nil
local ZoneFlagCmds = Library.Client:FindFirstChild("ZoneFlagCmds") and safeRequire(Library.Client.ZoneFlagCmds) or nil
local MachineCmds = Library.Client:FindFirstChild("MachineCmds") and safeRequire(Library.Client.MachineCmds) or nil
local MiscItem = Library.Items and Library.Items:FindFirstChild("MiscItem") and safeRequire(Library.Items.MiscItem) or nil
local PetItem = Library.Items and Library.Items:FindFirstChild("PetItem") and safeRequire(Library.Items.PetItem) or nil
local LootboxCmds = Library.Client:FindFirstChild("LootboxCmds") and safeRequire(Library.Client.LootboxCmds) or nil

if not Save or not ClientNetwork or not Directory then
    warn("[EQR] Required modules failed to load")
    return
end

