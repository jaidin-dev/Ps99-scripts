    CONFIG.WEBHOOK_URL = string.gsub(webhookBox.Text, "%s+", "")
    saveConfig()
    if CONFIG.WEBHOOK_URL ~= "" then
        local success, status = sendSummaryDigest(true)
        if success then
            addLog("Test sent")
            setStatus("Test sent")
        else
            addLog("Test failed (status: " .. tostring(status) .. ")")
            setStatus("Test failed")
        end
    else
        setStatus("Need webhook URL")
    end
end)

