local BOSS_CHEST_CFRAME = CFrame.new(1434.06567, 20.199398, -24874.4395, 0.271742523, 0.000449937157, 0.962369859, -0.00167914852, 0.999998569, 6.60821979e-06, -0.962368548, -0.00161775772, 0.27174291)
