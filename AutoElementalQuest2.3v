local SESSION_ENV = (getgenv and getgenv()) or _G
local QUEUE_ON_TELEPORT = queue_on_teleport
    or queueonteleport
    or (syn and syn.queue_on_teleport)
local TELEPORT_CONTINUATION_QUEUED = false

local function isValidMode(mode)
    return mode == "QUEST" or mode == "HUGE"
end

local function rememberSessionMode(mode)
    if isValidMode(mode) and SESSION_ENV then
        SESSION_ENV.EQR_SESSION_MODE = mode
    end
end

local SERVER_HISTORY = {}
if SESSION_ENV and type(SESSION_ENV.EQR_SERVER_HISTORY) == "table" then
    for _, serverId in ipairs(SESSION_ENV.EQR_SERVER_HISTORY) do
        if type(serverId) == "string" and serverId ~= "" then
            table.insert(SERVER_HISTORY, serverId)
        end
    end
end

local function syncServerHistorySession()
    while #SERVER_HISTORY > SERVER_HISTORY_LIMIT do
        table.remove(SERVER_HISTORY, 1)
    end

    if SESSION_ENV then
        local copy = {}
        for index, serverId in ipairs(SERVER_HISTORY) do
            copy[index] = serverId
        end
        SESSION_ENV.EQR_SERVER_HISTORY = copy
    end
end

local function isRecentServer(serverId)
    if not serverId then return false end
    for _, recentId in ipairs(SERVER_HISTORY) do
        if recentId == serverId then
            return true
        end
    end
    return false
end

local function rememberServerId(serverId)
    if type(serverId) ~= "string" or serverId == "" then return end
    for index = #SERVER_HISTORY, 1, -1 do
        if SERVER_HISTORY[index] == serverId then
            table.remove(SERVER_HISTORY, index)
        end
    end
    table.insert(SERVER_HISTORY, serverId)
    syncServerHistorySession()
end

rememberServerId(game.JobId)

player.OnTeleport:Connect(function(teleportState)
    local stateName = tostring(teleportState)
    if string.find(stateName, "Failed", 1, true) then
        TELEPORT_CONTINUATION_QUEUED = false
        return
    end

    if TELEPORT_CONTINUATION_QUEUED or not QUEUE_ON_TELEPORT or not isValidMode(CONFIG.MODE) then
        return
    end

    TELEPORT_CONTINUATION_QUEUED = true
    syncServerHistorySession()

    local modeLiteral = HttpService:JSONEncode(CONFIG.MODE)
    local historyJson = HttpService:JSONEncode(SERVER_HISTORY)
    local historyLiteral = HttpService:JSONEncode(historyJson)
    local urlLiteral = HttpService:JSONEncode(SCRIPT_URL)

    local queuedCode = table.concat({
        "local sessionEnv = (getgenv and getgenv()) or _G",
        "sessionEnv.EQR_SESSION_MODE = " .. modeLiteral,
        "sessionEnv.EQR_SERVER_HISTORY = game:GetService(\"HttpService\"):JSONDecode(" .. historyLiteral .. ")",
        "sessionEnv.EQR_RESUMED_FROM_TELEPORT = true",
        "task.wait(3)",
        "local source = game:HttpGet(" .. urlLiteral .. ")",
        "local chunk, compileError = loadstring(source)",
        "if not chunk then warn(\"[EQR] Compile error: \" .. tostring(compileError)); return end",
        "local ok, runError = pcall(chunk)",
        "if not ok then warn(\"[EQR] Runtime error: \" .. tostring(runError)) end",
    }, "\n")

    QUEUE_ON_TELEPORT(queuedCode)
end)

