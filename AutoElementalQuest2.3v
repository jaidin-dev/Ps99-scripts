--[[
    Elemental Quest Runner v3.2.0 (Ultimate Feature Restoration & Modern UI)
    -------------------------------------------------------------------------
    - All Original Features Restored (Config Toggles, Webhook Config, Test Webhook, Low Cube Alert Threshold)
    - Initial Mode Selection Modal (Quest Mode vs Huge Mode)
    - Multi-Tab Modern GUI (Dashboard Stats, Settings & Toggles, Webhook Setup, Event Logs)
    - Window Minimizer / Collapse Toggle
    - Throttled Shop Restock & Position-Based Boss Chest Detection
    - Easiest Quest Target Prioritization Engine
--]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local VirtualUser = game:GetService("VirtualUser")
local TeleportService = game:GetService("TeleportService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--------------------------------------------------------------------------------
-- SECTION 1: EQR_Runtime (Singleton & Cleanup Manager)
--------------------------------------------------------------------------------
local previousRuntime = _G.EQR_RUNTIME
if previousRuntime and type(previousRuntime.Cleanup) == "function" then
    pcall(function() previousRuntime:Cleanup() end)
end

local EQR_RUNTIME = {
    Version = "v3.2.0",
    RunId = (previousRuntime and previousRuntime.RunId or 0) + 1,
    Connections = {},
    Tasks = {},
    IsActive = true,
}
_G.EQR_RUNTIME = EQR_RUNTIME

function EQR_RUNTIME:AddConnection(conn)
    if typeof(conn) == "RBXScriptConnection" then
        table.insert(self.Connections, conn)
    end
    return conn
end

function EQR_RUNTIME:SpawnTask(fn)
    local t = task.spawn(function(...)
        if self.IsActive then fn(...) end
    end)
    table.insert(self.Tasks, t)
    return t
end

function EQR_RUNTIME:Cleanup()
    self.IsActive = false
    for _, conn in ipairs(self.Connections) do pcall(function() conn:Disconnect() end) end
    table.clear(self.Connections)
    for _, t in ipairs(self.Tasks) do pcall(function() task.cancel(t) end) end
    table.clear(self.Tasks)

    local oldGui = playerGui:FindFirstChild("EQR_Pro")
    if oldGui then oldGui:Destroy() end
    local oldSelector = playerGui:FindFirstChild("EQR_ModeSelector")
    if oldSelector then oldSelector:Destroy() end
end

local function isCurrentRun(runId)
    return EQR_RUNTIME.IsActive and EQR_RUNTIME.RunId == runId
end

--------------------------------------------------------------------------------
-- SECTION 2: Configuration Manager
--------------------------------------------------------------------------------
local CONFIG_FILE = "ElementalQuestRunner_Config.json"

local CONFIG = {
    RUNNING = false,
    MODE = "QUEST", -- "QUEST" or "HUGE"
    USE_ULTRA = false,
    AUTO_RESTOCK = true,
    AUTO_FRUITS = true,
    AUTO_BREAK = true,
    ALERT_RARE = true,
    ALERT_LOW_CUBES = true,
    CUBE_ALERT_THRESHOLD = 50,
    WEBHOOK_URL = "",
    SHOP_INTERVAL = 45,
}

local function loadConfig()
    local isFileFunc = isfile or (syn and syn.isfile)
    local readFileFunc = readfile or (syn and syn.readfile)
    if isFileFunc and readFileFunc and isFileFunc(CONFIG_FILE) then
        pcall(function()
            local data = HttpService:JSONDecode(readFileFunc(CONFIG_FILE))
            if type(data) == "table" then
                for k, v in pairs(data) do
                    if k ~= "MODE" and k ~= "RUNNING" and CONFIG[k] ~= nil then
                        CONFIG[k] = v
                    end
                end
            end
        end)
    end
end

local function saveConfig()
    local writeFileFunc = writefile or (syn and syn.writefile)
    if writeFileFunc then
        pcall(function()
            local saveCopy = {}
            for k, v in pairs(CONFIG) do
                if k ~= "MODE" and k ~= "RUNNING" then saveCopy[k] = v end
            end
            writeFileFunc(CONFIG_FILE, HttpService:JSONEncode(saveCopy))
        end)
    end
end

loadConfig()

--------------------------------------------------------------------------------
-- SECTION 3: Webhook Service & Event Queue
--------------------------------------------------------------------------------
local WebhookService = { Queue = {}, IsProcessing = false, RateLimitUntil = 0 }
local WEBHOOK_COLORS = { GREEN = 3066993, RED = 15158332, GOLD = 15844367, BLUE = 3447003, PURPLE = 10181046, TEAL = 1752220 }

function WebhookService:Push(title, description, color, fields)
    if not CONFIG.WEBHOOK_URL or CONFIG.WEBHOOK_URL == "" then return end
    if not string.match(CONFIG.WEBHOOK_URL, "^https?://") then return end
    table.insert(self.Queue, { Title = title, Description = description, Color = color or WEBHOOK_COLORS.GREEN, Fields = fields or {} })
    self:ProcessQueue()
end

function WebhookService:ProcessQueue()
    if self.IsProcessing then return end
    self.IsProcessing = true
    EQR_RUNTIME:SpawnTask(function()
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        while #self.Queue > 0 and EQR_RUNTIME.IsActive do
            if os.clock() < self.RateLimitUntil then task.wait(0.5) continue end
            local item = table.remove(self.Queue, 1)
            local payload = HttpService:JSONEncode({
                embeds = {{
                    title = item.Title, description = item.Description, color = item.Color, fields = item.Fields,
                    footer = { text = "Quest Runner " .. EQR_RUNTIME.Version .. " • " .. os.date("%X") },
                    timestamp = DateTime.now():ToIsoDate()
                }}
            })
            pcall(function()
                req({ Url = CONFIG.WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = payload })
            end)
            task.wait(0.3)
        end
        self.IsProcessing = false
    end)
end

--------------------------------------------------------------------------------
-- SECTION 4: Game Services & References
--------------------------------------------------------------------------------
local Library = ReplicatedStorage:WaitForChild("Library", 10)
if not Library then warn("[EQR] Library module missing!"); return end

local function safeRequire(path)
    local ok, res = pcall(require, path)
    return ok and res or nil
end

local Save = safeRequire(Library.Client:WaitForChild("Save"))
local ClientNetwork = safeRequire(Library.Client:WaitForChild("Network"))
local MapCmds = safeRequire(Library.Client:WaitForChild("MapCmds"))
local Directory = safeRequire(Library.Directory)
local FruitCmds = Library.Client:FindFirstChild("FruitCmds") and safeRequire(Library.Client.FruitCmds) or nil
local MiscItem = Library.Items and Library.Items:FindFirstChild("MiscItem") and safeRequire(Library.Items.MiscItem) or nil
local PetItem = Library.Items and Library.Items:FindFirstChild("PetItem") and safeRequire(Library.Items.PetItem) or nil

local QUEST_ID = "ElementalQuests"
local SCRIPT_URL = "https://raw.githubusercontent.com/jaidin-dev/Ps99-scripts/refs/heads/main/AutoElementalQuest2.3v"
local FARM_ZONE_CFRAME = CFrame.new(1427.29, 17.5, -24949.01)
local SHOP_CFRAME = CFrame.new(783.18, 19.52, -24890.54)
local BOSS_CHEST_CFRAME = CFrame.new(1434.06, 20.19, -24874.43)
local BOSS_CHEST_SPAWN_POS = BOSS_CHEST_CFRAME.Position
local PET_CUBE_STORE_ID = "PetCubeStore"

local STATS = {
    StartTime = os.time(),
    QuestsCompleted = 0,
    PetsCaught = 0,
    PetsEscaped = 0,
    ChestsBroken = 0,
    CubesSpent = 0,
    DiamondsSpent = 0,
    FruitsEaten = 0,
    RareCatches = 0,
}

local LOG_ENTRIES = {}
local LAST_SHOP_VISIT = 0

local function addLog(msg)
    local entry = string.format("[%s] %s", os.date("%H:%M:%S"), msg)
    table.insert(LOG_ENTRIES, 1, entry)
    if #LOG_ENTRIES > 30 then table.remove(LOG_ENTRIES, #LOG_ENTRIES) end
    if _G.EQR_LOG_UI then
        _G.EQR_LOG_UI.Text = table.concat(LOG_ENTRIES, "\n")
    end
    print("[EQR] " .. msg)
end

local function getCubeName(forceUltra)
    if forceUltra == true then return "Ultra Pet Cube" end
    if forceUltra == false then return "Pet Cube" end
    return CONFIG.USE_ULTRA and "Ultra Pet Cube" or "Pet Cube"
end

local function getCubeCount(forceUltra)
    local cubeName = getCubeName(forceUltra)
    if MiscItem then
        local ok, item = pcall(function() return MiscItem(cubeName) end)
        if ok and item then
            local countOk, count = pcall(function() return item:CountExact() end)
            if countOk and count then return count end
        end
    end
    local data = Save and Save.Get()
    local miscInv = data and data.Inventory and data.Inventory.Misc or {}
    local count = 0
    for _, itemData in pairs(miscInv) do
        if type(itemData) == "table" and itemData.id == cubeName then
            count = count + (itemData._am or 1)
        end
    end
    return count
end

--------------------------------------------------------------------------------
-- SECTION 5: Quest Goal Matching & Pet Selection
--------------------------------------------------------------------------------
local function getQuestData()
    local data = Save and Save.Get()
    return data and data.NPCQuests and data.NPCQuests[QUEST_ID] or nil
end

local function getRequiredPets()
    local quest = getQuestData()
    local targets = {}
    for _, goal in pairs(quest and quest.Quests or {}) do
        if goal.PetID and (goal.Progress or 0) < (goal.Amount or 0) then
            local remaining = (goal.Amount or 0) - (goal.Progress or 0)
            targets[goal.PetID] = (targets[goal.PetID] or 0) + remaining
        end
    end
    return targets
end

local function questComplete()
    local quest = getQuestData()
    if not quest or not quest.Quests or #quest.Quests == 0 then return false end
    for _, goal in pairs(quest.Quests) do
        if (goal.Progress or 0) < (goal.Amount or 0) then return false end
    end
    return true
end

local function ensureQuestData()
    local quest = getQuestData()
    if quest and quest.Quests and #quest.Quests > 0 then return true end
    pcall(function() ClientNetwork.Invoke("NPC Quests: Ensure", QUEST_ID) end)
    return false
end

local function getRoamingPetId(entry)
    if PetItem then
        local ok, item = pcall(function() return PetItem:From(entry.Pet) end)
        if ok and item and item.GetId then return item:GetId() end
    end
    if entry and entry.Pet then
        local petId = entry.Pet.id or entry.Pet
        if type(petId) == "string" then return petId end
    end
    return nil
end

local function chooseBestTarget()
    local data = Save and Save.Get()
    local roaming = data and data.RoamingPets or {}
    local questTargets = getRequiredPets()

    local bestGoalIndex, bestGoalPet, bestGoalChance = nil, nil, math.huge
    local bestAnyIndex, bestAnyPet, bestAnyChance = nil, nil, math.huge

    for index, entry in pairs(roaming) do
        local petId = getRoamingPetId(entry)
        local chance = tonumber(entry.Chance) or 999999

        if petId and questTargets[petId] then
            if chance < bestGoalChance then
                bestGoalIndex = index
                bestGoalPet = petId
                bestGoalChance = chance
            end
        end

        if chance < bestAnyChance then
            bestAnyIndex = index
            bestAnyPet = petId
            bestAnyChance = chance
        end
    end

    if bestGoalIndex then return bestGoalIndex, bestGoalPet, "QUEST_GOAL" end
    if bestAnyIndex then return bestAnyIndex, bestAnyPet, "EASIEST_FALLBACK" end
    return nil, nil, nil
end

--------------------------------------------------------------------------------
-- SECTION 6: Boss Chest & Auto Fruits
--------------------------------------------------------------------------------
local BossChestService = {}

function BossChestService:GetBossChest()
    local things = workspace:FindFirstChild("__THINGS")
    local breakables = things and things:FindFirstChild("Breakables")
    if not breakables then return nil end

    for _, model in ipairs(breakables:GetChildren()) do
        if model:IsA("Model") then
            local pos = model:GetPivot().Position
            if (pos - BOSS_CHEST_SPAWN_POS).Magnitude < 30 then
                return model
            end
        end
    end
    return nil
end

local function autoEatFruits()
    if not FruitCmds or not CONFIG.AUTO_FRUITS then return end
    local fruitTypes = { "Apple", "Banana", "Orange", "Pineapple", "Watermelon", "Rainbow Fruit" }
    for _, fruit in ipairs(fruitTypes) do
        pcall(function()
            local needed = nil
            pcall(function() needed = FruitCmds:GetMaxConsume(fruit) end)
            if needed and needed > 0 then
                local ok, result = pcall(function() return FruitCmds:Consume(fruit, needed) end)
                if ok and result ~= false then
                    STATS.FruitsEaten = STATS.FruitsEaten + needed
                end
            end
        end)
    end
end

--------------------------------------------------------------------------------
-- SECTION 7: Server Hopping & Teleport Loader
--------------------------------------------------------------------------------
local SESSION_ENV = (getgenv and getgenv()) or _G
local QUEUE_ON_TELEPORT = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
local IS_HOPPING = false

local function setupTeleportContinuation()
    EQR_RUNTIME:AddConnection(player.OnTeleport:Connect(function(teleportState)
        if not QUEUE_ON_TELEPORT or not CONFIG.RUNNING then return end
        local modeLit = HttpService:JSONEncode(CONFIG.MODE)
        local urlLit = HttpService:JSONEncode(SCRIPT_URL)
        local scriptText = table.concat({
            "local sessionEnv = (getgenv and getgenv()) or _G",
            "sessionEnv.EQR_SESSION_MODE = " .. modeLit,
            "task.wait(2)",
            "local url = " .. urlLit,
            "local ok, source = pcall(function() return game:HttpGet(url) end)",
            "if ok and source then pcall(loadstring(source)) end"
        }, "\n")
        QUEUE_ON_TELEPORT(scriptText)
    end))
end
setupTeleportContinuation()

local function serverHop()
    if IS_HOPPING then return false end
    IS_HOPPING = true
    addLog("Scanning for fresh server...")
    WebhookService:Push("Server Hopping", "Hopping to fresh server...", WEBHOOK_COLORS.BLUE)

    local placeId = game.PlaceId
    local currentJobId = game.JobId

    pcall(function()
        local body = game:HttpGet(string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", placeId))
        local decoded = HttpService:JSONDecode(body)
        local fresh = {}
        for _, s in ipairs(decoded.data or {}) do
            if s.id ~= currentJobId and (s.playing or 0) < (s.maxPlayers or 0) then
                table.insert(fresh, s.id)
            end
        end
        if #fresh > 0 then
            TeleportService:TeleportToPlaceInstance(placeId, fresh[math.random(1, #fresh)], player)
        end
    end)
    task.wait(3)
    IS_HOPPING = false
end

--------------------------------------------------------------------------------
-- SECTION 8: State Machine & Execution Loop
--------------------------------------------------------------------------------
local StateMachine = { CurrentState = "IDLE", StateDetail = "Ready", UIListeners = {} }

function StateMachine:SetState(state, detail)
    self.CurrentState = state or "IDLE"
    self.StateDetail = detail or ""
    for _, fn in ipairs(self.UIListeners) do pcall(fn, self.CurrentState, self.StateDetail) end
end

local function getRootPart()
    local char = player.Character or player.CharacterAdded:Wait()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function movePlayer(targetCFrame, statusText)
    local root = getRootPart()
    if not root or not targetCFrame then return false end
    if statusText then StateMachine:SetState("TRAVEL", statusText) end
    root.CFrame = targetCFrame
    task.wait(0.4)
    return true
end

local function visitShopIfNeeded()
    if not CONFIG.AUTO_RESTOCK then return false end
    local cubesLeft = getCubeCount()
    local now = os.clock()

    if cubesLeft >= 15 and (now - LAST_SHOP_VISIT) < CONFIG.SHOP_INTERVAL then
        return false
    end

    LAST_SHOP_VISIT = now
    addLog("Visiting Pet Cube shop for restock...")
    StateMachine:SetState("SHOP", "Buying Pet Cubes")
    if movePlayer(SHOP_CFRAME, "Teleporting to Shop") then
        task.wait(0.5)
        for _, slot in ipairs({1, 2, 3}) do
            pcall(function() ClientNetwork.Invoke("Merchant_RequestPurchase", PET_CUBE_STORE_ID, slot) end)
            task.wait(0.2)
        end
        movePlayer(FARM_ZONE_CFRAME, "Returning to Realm")
        return true
    end
    return false
end

local function breakBossChest(chestModel)
    if not chestModel or not chestModel.Parent then return false end
    local net = ReplicatedStorage:FindFirstChild("Network")
    local damageRemote = net and net:FindFirstChild("Breakables_PlayerDealDamage")
    if not damageRemote then return false end

    addLog("Attacking Boss Chest...")
    movePlayer(BOSS_CHEST_CFRAME, "Breaking Boss Chest")
    StateMachine:SetState("CHEST", "Breaking Boss Chest")

    local start = os.clock()
    while os.clock() - start < 25 and chestModel.Parent and CONFIG.RUNNING do
        local root = getRootPart()
        if root then root.CFrame = BOSS_CHEST_CFRAME end
        damageRemote:FireServer(chestModel.Name)
        task.wait(0.15)
    end

    if not chestModel.Parent then
        STATS.ChestsBroken = STATS.ChestsBroken + 1
        addLog("Boss Chest destroyed!")
        return true
    end
    return false
end

local function executeMainLoop()
    EQR_RUNTIME:SpawnTask(function()
        local currentRunId = EQR_RUNTIME.RunId

        while isCurrentRun(currentRunId) do
            if not CONFIG.RUNNING then
                StateMachine:SetState("IDLE", "Paused")
                task.wait(0.5)
                continue
            end

            autoEatFruits()

            -- 1. Check & break Boss Chest if spawned
            local bossChest = CONFIG.AUTO_BREAK and BossChestService:GetBossChest()
            if bossChest then
                breakBossChest(bossChest)
            end

            -- 2. Check shop restock (throttled to 45s or low cubes)
            visitShopIfNeeded()

            if CONFIG.MODE == "HUGE" then
                serverHop()
                task.wait(3)
            else
                -- QUEST MODE
                if questComplete() then
                    StateMachine:SetState("CLAIM", "Redeeming Quest")
                    addLog("Quest complete! Claiming reward...")
                    pcall(function() ClientNetwork.Invoke("NPC Quests: Redeem", QUEST_ID) end)
                    STATS.QuestsCompleted = STATS.QuestsCompleted + 1
                    task.wait(1.5)
                    continue
                end

                ensureQuestData()

                local tIndex, tPet, tReason = chooseBestTarget()
                if tIndex then
                    StateMachine:SetState("CATCHING", "Catching " .. tostring(tPet))
                    local cubeType = CONFIG.USE_ULTRA and "Ultra Pet Cube" or "Pet Cube"
                    local ok, _ = pcall(function()
                        return ClientNetwork.Invoke("RoamingPets_CatchPet", cubeType, tIndex)
                    end)
                    if ok then
                        STATS.PetsCaught = STATS.PetsCaught + 1
                        STATS.CubesSpent = STATS.CubesSpent + 1
                        addLog("Caught " .. tostring(tPet) .. " (" .. tReason .. ")")
                    end
                else
                    StateMachine:SetState("SCANNING", "Waiting for Pets")
                end

                task.wait(1.8)
            end
        end
    end)
end

--------------------------------------------------------------------------------
-- SECTION 9: Ultimate Dashboard UI (Tabs, Webhook Config & Modern Aesthetics)
--------------------------------------------------------------------------------
local function buildUI()
    local old = playerGui:FindFirstChild("EQR_Pro")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "EQR_Pro"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui

    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = UDim2.fromOffset(480, 360)
    mainFrame.Position = UDim2.new(0.5, -240, 0.5, -180)
    mainFrame.BackgroundColor3 = Color3.fromRGB(13, 15, 24)
    mainFrame.BorderSizePixel = 0
    mainFrame.Active = true
    mainFrame.ClipsDescendants = true
    mainFrame.Parent = gui

    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 12); corner.Parent = mainFrame
    local stroke = Instance.new("UIStroke"); stroke.Color = Color3.fromRGB(88, 101, 242); stroke.Thickness = 1.2; stroke.Transparency = 0.15; stroke.Parent = mainFrame

    -- Header Drag Bar
    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, 0, 0, 42)
    header.BackgroundColor3 = Color3.fromRGB(22, 25, 40)
    header.BorderSizePixel = 0
    header.Parent = mainFrame
    local hc = Instance.new("UICorner"); hc.CornerRadius = UDim.new(0, 12); hc.Parent = header

    local dragging, dragStart, startPos
    EQR_RUNTIME:AddConnection(header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = mainFrame.Position
        end
    end))
    EQR_RUNTIME:AddConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))
    EQR_RUNTIME:AddConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0, 200, 1, 0)
    title.Position = UDim2.fromOffset(14, 0)
    title.BackgroundTransparency = 1
    title.Text = "⚡ Quest Runner v3.2"
    title.TextColor3 = Color3.fromRGB(240, 243, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = header

    local statusPill = Instance.new("TextLabel")
    statusPill.Size = UDim2.new(0, 140, 0, 24)
    statusPill.Position = UDim2.new(1, -200, 0.5, -12)
    statusPill.BackgroundColor3 = Color3.fromRGB(34, 38, 58)
    statusPill.Text = "IDLE • Ready"
    statusPill.TextColor3 = Color3.fromRGB(160, 225, 180)
    statusPill.Font = Enum.Font.GothamMedium
    statusPill.TextSize = 11
    statusPill.Parent = header
    local pillC = Instance.new("UICorner"); pillC.CornerRadius = UDim.new(0, 6); pillC.Parent = statusPill

    local isCollapsed = false
    local minimizeBtn = Instance.new("TextButton")
    minimizeBtn.Size = UDim2.fromOffset(24, 24)
    minimizeBtn.Position = UDim2.new(1, -54, 0.5, -12)
    minimizeBtn.BackgroundColor3 = Color3.fromRGB(45, 52, 75)
    minimizeBtn.Text = "−"
    minimizeBtn.TextColor3 = Color3.new(1, 1, 1)
    minimizeBtn.Font = Enum.Font.GothamBold
    minimizeBtn.TextSize = 14
    minimizeBtn.Parent = header
    local minC = Instance.new("UICorner"); minC.CornerRadius = UDim.new(0, 5); minC.Parent = minimizeBtn

    minimizeBtn.MouseButton1Click:Connect(function()
        isCollapsed = not isCollapsed
        mainFrame.Size = isCollapsed and UDim2.fromOffset(480, 42) or UDim2.fromOffset(480, 360)
        minimizeBtn.Text = isCollapsed and "+" or "−"
    end)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.fromOffset(24, 24)
    closeBtn.Position = UDim2.new(1, -28, 0.5, -12)
    closeBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 12
    closeBtn.Parent = header
    local closeC = Instance.new("UICorner"); closeC.CornerRadius = UDim.new(0, 5); closeC.Parent = closeBtn
    closeBtn.MouseButton1Click:Connect(function()
        CONFIG.RUNNING = false
        saveConfig()
        gui:Destroy()
    end)

    -- Top Action Control Buttons
    local startBtn = Instance.new("TextButton")
    startBtn.Size = UDim2.new(0.48, -12, 0, 34)
    startBtn.Position = UDim2.fromOffset(12, 50)
    startBtn.BackgroundColor3 = Color3.fromRGB(46, 160, 90)
    startBtn.Text = "▶ START RUNNER"
    startBtn.TextColor3 = Color3.new(1, 1, 1)
    startBtn.Font = Enum.Font.GothamBold
    startBtn.TextSize = 12
    startBtn.Parent = mainFrame
    local startC = Instance.new("UICorner"); startC.CornerRadius = UDim.new(0, 6); startC.Parent = startBtn

    startBtn.MouseButton1Click:Connect(function()
        CONFIG.RUNNING = not CONFIG.RUNNING
        startBtn.Text = CONFIG.RUNNING and "⏸ PAUSE RUNNER" or "▶ START RUNNER"
        startBtn.BackgroundColor3 = CONFIG.RUNNING and Color3.fromRGB(190, 70, 60) or Color3.fromRGB(46, 160, 90)
        saveConfig()
    end)

    local modeBtn = Instance.new("TextButton")
    modeBtn.Size = UDim2.new(0.48, -12, 0, 34)
    modeBtn.Position = UDim2.new(0.5, 6, 0, 50)
    modeBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    modeBtn.Text = "🎯 MODE: " .. CONFIG.MODE
    modeBtn.TextColor3 = Color3.new(1, 1, 1)
    modeBtn.Font = Enum.Font.GothamBold
    modeBtn.TextSize = 12
    modeBtn.Parent = mainFrame
    local modeC = Instance.new("UICorner"); modeC.CornerRadius = UDim.new(0, 6); modeC.Parent = modeBtn

    modeBtn.MouseButton1Click:Connect(function()
        CONFIG.MODE = CONFIG.MODE == "QUEST" and "HUGE" or "QUEST"
        modeBtn.Text = "🎯 MODE: " .. CONFIG.MODE
        saveConfig()
    end)

    -- Tab Navigation Buttons
    local tabContainer = Instance.new("Frame")
    tabContainer.Size = UDim2.new(1, -24, 0, 28)
    tabContainer.Position = UDim2.fromOffset(12, 92)
    tabContainer.BackgroundTransparency = 1
    tabContainer.Parent = mainFrame

    local tabs = { "DASHBOARD", "SETTINGS", "WEBHOOK", "LOGS" }
    local tabButtons = {}
    local tabPages = {}

    local pageContainer = Instance.new("Frame")
    pageContainer.Size = UDim2.new(1, -24, 0, 224)
    pageContainer.Position = UDim2.fromOffset(12, 124)
    pageContainer.BackgroundTransparency = 1
    pageContainer.Parent = mainFrame

    for idx, tabName in ipairs(tabs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.24, -2, 1, 0)
        btn.Position = UDim2.new((idx-1)*0.25, 0, 0, 0)
        btn.BackgroundColor3 = idx == 1 and Color3.fromRGB(88, 101, 242) or Color3.fromRGB(24, 28, 44)
        btn.Text = tabName
        btn.TextColor3 = idx == 1 and Color3.new(1,1,1) or Color3.fromRGB(160, 168, 195)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 10
        btn.Parent = tabContainer
        local btnC = Instance.new("UICorner"); btnC.CornerRadius = UDim.new(0, 6); btnC.Parent = btn

        local page = Instance.new("Frame")
        page.Size = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency = 1
        page.Visible = (idx == 1)
        page.Parent = pageContainer

        tabButtons[tabName] = btn
        tabPages[tabName] = page

        btn.MouseButton1Click:Connect(function()
            for tName, tBtn in pairs(tabButtons) do
                tBtn.BackgroundColor3 = (tName == tabName) and Color3.fromRGB(88, 101, 242) or Color3.fromRGB(24, 28, 44)
                tBtn.TextColor3 = (tName == tabName) and Color3.new(1,1,1) or Color3.fromRGB(160, 168, 195)
            end
            for tName, tPage in pairs(tabPages) do
                tPage.Visible = (tName == tabName)
            end
        end)
    end

    ----------------------------------------------------------------------------
    -- TAB 1: DASHBOARD
    ----------------------------------------------------------------------------
    local dashPage = tabPages["DASHBOARD"]
    local statsGrid = Instance.new("Frame")
    statsGrid.Size = UDim2.new(1, 0, 1, 0)
    statsGrid.BackgroundColor3 = Color3.fromRGB(20, 23, 34)
    statsGrid.Parent = dashPage
    local sgC = Instance.new("UICorner"); sgC.CornerRadius = UDim.new(0, 8); sgC.Parent = statsGrid

    local statsText = Instance.new("TextLabel")
    statsText.Size = UDim2.new(1, -20, 1, -16)
    statsText.Position = UDim2.fromOffset(10, 8)
    statsText.BackgroundTransparency = 1
    statsText.Text = "Initializing stats..."
    statsText.TextColor3 = Color3.fromRGB(210, 222, 245)
    statsText.Font = Enum.Font.Code
    statsText.TextSize = 12
    statsText.TextXAlignment = Enum.TextXAlignment.Left
    statsText.TextYAlignment = Enum.TextYAlignment.Top
    statsText.Parent = statsGrid

    ----------------------------------------------------------------------------
    -- TAB 2: SETTINGS (Full Original Toggles Restored)
    ----------------------------------------------------------------------------
    local setPage = tabPages["SETTINGS"]
    local setScroll = Instance.new("ScrollingFrame")
    setScroll.Size = UDim2.new(1, 0, 1, 0)
    setScroll.BackgroundTransparency = 1
    setScroll.CanvasSize = UDim2.new(0, 0, 0, 260)
    setScroll.ScrollBarThickness = 4
    setScroll.Parent = setPage

    local toggleConfigs = {
        { Key = "USE_ULTRA", Label = "Use Ultra Pet Cubes" },
        { Key = "AUTO_RESTOCK", Label = "Auto Restock Cubes from Merchant" },
        { Key = "AUTO_FRUITS", Label = "Auto Consume Fruit Boosts" },
        { Key = "AUTO_BREAK", Label = "Auto Break Boss Chest" },
        { Key = "ALERT_RARE", Label = "Send Discord Alert on Rare / Huge" },
        { Key = "ALERT_LOW_CUBES", Label = "Alert on Low Cube Count" },
    }

    for i, cfg in ipairs(toggleConfigs) do
        local tBtn = Instance.new("TextButton")
        tBtn.Size = UDim2.new(1, 0, 0, 30)
        tBtn.Position = UDim2.fromOffset(0, (i-1)*34)
        tBtn.BackgroundColor3 = CONFIG[cfg.Key] and Color3.fromRGB(38, 48, 75) or Color3.fromRGB(22, 25, 38)
        tBtn.Text = "  " .. cfg.Label .. ": " .. (CONFIG[cfg.Key] and "ON" or "OFF")
        tBtn.TextColor3 = CONFIG[cfg.Key] and Color3.fromRGB(160, 220, 255) or Color3.fromRGB(150, 155, 170)
        tBtn.Font = Enum.Font.GothamMedium
        tBtn.TextSize = 11
        tBtn.TextXAlignment = Enum.TextXAlignment.Left
        tBtn.Parent = setScroll
        local tbC = Instance.new("UICorner"); tbC.CornerRadius = UDim.new(0, 6); tbC.Parent = tBtn

        tBtn.MouseButton1Click:Connect(function()
            CONFIG[cfg.Key] = not CONFIG[cfg.Key]
            tBtn.Text = "  " .. cfg.Label .. ": " .. (CONFIG[cfg.Key] and "ON" or "OFF")
            tBtn.BackgroundColor3 = CONFIG[cfg.Key] and Color3.fromRGB(38, 48, 75) or Color3.fromRGB(22, 25, 38)
            tBtn.TextColor3 = CONFIG[cfg.Key] and Color3.fromRGB(160, 220, 255) or Color3.fromRGB(150, 155, 170)
            saveConfig()
        end)
    end

    -- Low Cube Threshold Input
    local threshFrame = Instance.new("Frame")
    threshFrame.Size = UDim2.new(1, 0, 0, 32)
    threshFrame.Position = UDim2.fromOffset(0, #toggleConfigs * 34)
    threshFrame.BackgroundColor3 = Color3.fromRGB(22, 25, 38)
    threshFrame.Parent = setScroll
    local tfC = Instance.new("UICorner"); tfC.CornerRadius = UDim.new(0, 6); tfC.Parent = threshFrame

    local threshLabel = Instance.new("TextLabel")
    threshLabel.Size = UDim2.new(0.65, 0, 1, 0)
    threshLabel.Position = UDim2.fromOffset(10, 0)
    threshLabel.BackgroundTransparency = 1
    threshLabel.Text = "Cube Alert Threshold:"
    threshLabel.TextColor3 = Color3.fromRGB(200, 205, 220)
    threshLabel.Font = Enum.Font.GothamMedium
    threshLabel.TextSize = 11
    threshLabel.TextXAlignment = Enum.TextXAlignment.Left
    threshLabel.Parent = threshFrame

    local threshBox = Instance.new("TextBox")
    threshBox.Size = UDim2.new(0.3, -10, 0, 24)
    threshBox.Position = UDim2.new(0.7, 0, 0.5, -12)
    threshBox.BackgroundColor3 = Color3.fromRGB(15, 17, 26)
    threshBox.Text = tostring(CONFIG.CUBE_ALERT_THRESHOLD)
    threshBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    threshBox.Font = Enum.Font.GothamBold
    threshBox.TextSize = 11
    threshBox.Parent = threshFrame
    local tbxC = Instance.new("UICorner"); tbxC.CornerRadius = UDim.new(0, 4); tbxC.Parent = threshBox

    threshBox.FocusLost:Connect(function()
        local val = tonumber(threshBox.Text)
        if val then CONFIG.CUBE_ALERT_THRESHOLD = math.floor(val); saveConfig() end
    end)

    ----------------------------------------------------------------------------
    -- TAB 3: WEBHOOK SETUP & TESTING
    ----------------------------------------------------------------------------
    local webPage = tabPages["WEBHOOK"]
    local webCard = Instance.new("Frame")
    webCard.Size = UDim2.new(1, 0, 1, 0)
    webCard.BackgroundColor3 = Color3.fromRGB(20, 23, 34)
    webCard.Parent = webPage
    local wcC = Instance.new("UICorner"); wcC.CornerRadius = UDim.new(0, 8); wcC.Parent = webCard

    local wLabel = Instance.new("TextLabel")
    wLabel.Size = UDim2.new(1, -20, 0, 24)
    wLabel.Position = UDim2.fromOffset(10, 10)
    wLabel.BackgroundTransparency = 1
    wLabel.Text = "Discord Webhook URL:"
    wLabel.TextColor3 = Color3.fromRGB(200, 205, 225)
    wLabel.Font = Enum.Font.GothamBold
    wLabel.TextSize = 12
    wLabel.TextXAlignment = Enum.TextXAlignment.Left
    wLabel.Parent = webCard

    local wBox = Instance.new("TextBox")
    wBox.Size = UDim2.new(1, -20, 0, 32)
    wBox.Position = UDim2.fromOffset(10, 38)
    wBox.BackgroundColor3 = Color3.fromRGB(13, 15, 24)
    wBox.Text = CONFIG.WEBHOOK_URL
    wBox.PlaceholderText = "Paste Discord Webhook URL here..."
    wBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    wBox.Font = Enum.Font.Code
    wBox.TextSize = 10
    wBox.TextTruncate = Enum.TextTruncate.AtEnd
    wBox.Parent = webCard
    local wbc = Instance.new("UICorner"); wbc.CornerRadius = UDim.new(0, 6); wbc.Parent = wBox

    wBox.FocusLost:Connect(function()
        CONFIG.WEBHOOK_URL = string.gsub(wBox.Text, "%s+", "")
        saveConfig()
        addLog("Webhook URL saved")
    end)

    local testWebBtn = Instance.new("TextButton")
    testWebBtn.Size = UDim2.new(0.47, 0, 0, 32)
    testWebBtn.Position = UDim2.fromOffset(10, 82)
    testWebBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    testWebBtn.Text = "🧪 TEST WEBHOOK"
    testWebBtn.TextColor3 = Color3.new(1, 1, 1)
    testWebBtn.Font = Enum.Font.GothamBold
    testWebBtn.TextSize = 11
    testWebBtn.Parent = webCard
    local twC = Instance.new("UICorner"); twC.CornerRadius = UDim.new(0, 6); twC.Parent = testWebBtn

    testWebBtn.MouseButton1Click:Connect(function()
        WebhookService:Push("Test Notification", "Quest Runner webhook integration working cleanly!", WEBHOOK_COLORS.GOLD)
        addLog("Test webhook notification sent!")
    end)

    local summaryWebBtn = Instance.new("TextButton")
    summaryWebBtn.Size = UDim2.new(0.47, 0, 0, 32)
    summaryWebBtn.Position = UDim2.new(0.53, 0, 0, 82)
    summaryWebBtn.BackgroundColor3 = Color3.fromRGB(46, 160, 90)
    summaryWebBtn.Text = "📊 SEND SUMMARY"
    summaryWebBtn.TextColor3 = Color3.new(1, 1, 1)
    summaryWebBtn.Font = Enum.Font.GothamBold
    summaryWebBtn.TextSize = 11
    summaryWebBtn.Parent = webCard
    local swC = Instance.new("UICorner"); swC.CornerRadius = UDim.new(0, 6); swC.Parent = summaryWebBtn

    summaryWebBtn.MouseButton1Click:Connect(function()
        WebhookService:Push("Manual Summary", "Stats: Quests=" .. STATS.QuestsCompleted .. ", Pets=" .. STATS.PetsCaught .. ", Chests=" .. STATS.ChestsBroken, WEBHOOK_COLORS.TEAL)
        addLog("Summary webhook sent!")
    end)

    ----------------------------------------------------------------------------
    -- TAB 4: EVENT LOGS
    ----------------------------------------------------------------------------
    local logPage = tabPages["LOGS"]
    local logScroll = Instance.new("ScrollingFrame")
    logScroll.Size = UDim2.new(1, 0, 1, 0)
    logScroll.BackgroundColor3 = Color3.fromRGB(15, 17, 26)
    logScroll.CanvasSize = UDim2.new(0, 0, 0, 500)
    logScroll.ScrollBarThickness = 4
    logScroll.Parent = logPage
    local lcC = Instance.new("UICorner"); lcC.CornerRadius = UDim.new(0, 8); lcC.Parent = logScroll

    local logText = Instance.new("TextLabel")
    logText.Size = UDim2.new(1, -16, 1, -12)
    logText.Position = UDim2.fromOffset(8, 6)
    logText.BackgroundTransparency = 1
    logText.Text = table.concat(LOG_ENTRIES, "\n")
    logText.TextColor3 = Color3.fromRGB(180, 220, 190)
    logText.Font = Enum.Font.Code
    logText.TextSize = 10
    logText.TextXAlignment = Enum.TextXAlignment.Left
    logText.TextYAlignment = Enum.TextYAlignment.Top
    logText.Parent = logScroll

    _G.EQR_LOG_UI = logText

    ----------------------------------------------------------------------------
    -- State Machine UI Listener Update
    ----------------------------------------------------------------------------
    table.insert(StateMachine.UIListeners, function(state, detail)
        statusPill.Text = string.upper(state) .. " • " .. string.sub(detail, 1, 14)
        local elapsed = os.time() - STATS.StartTime
        statsText.Text = string.format(
            "=================== DASHBOARD ===================\n" ..
            "Mode:          %s\n" ..
            "State:         %s (%s)\n" ..
            "Runtime:       %02d:%02d:%02d\n\n" ..
            "Quests Done:   %d\n" ..
            "Pets Caught:   %d\n" ..
            "Chests Broke:  %d\n" ..
            "Cubes Spent:   %d\n" ..
            "Cubes Left:    %d %s\n" ..
            "Target Rule:   Easiest Active Quest Goal First\n" ..
            "=================================================",
            CONFIG.MODE, state, detail,
            math.floor(elapsed / 3600), math.floor((elapsed % 3600) / 60), elapsed % 60,
            STATS.QuestsCompleted, STATS.PetsCaught, STATS.ChestsBroken, STATS.CubesSpent,
            getCubeCount(), getCubeName()
        )
    end)
end

--------------------------------------------------------------------------------
-- SECTION 10: Mode Selection Startup Modal
--------------------------------------------------------------------------------
local function promptModeSelection()
    local existingSelector = playerGui:FindFirstChild("EQR_ModeSelector")
    if existingSelector then existingSelector:Destroy() end

    local modalGui = Instance.new("ScreenGui")
    modalGui.Name = "EQR_ModeSelector"
    modalGui.ResetOnSpawn = false
    modalGui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(340, 200)
    frame.Position = UDim2.new(0.5, -170, 0.5, -100)
    frame.BackgroundColor3 = Color3.fromRGB(15, 17, 26)
    frame.Parent = modalGui
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 12); fc.Parent = frame
    local fs = Instance.new("UIStroke"); fs.Color = Color3.fromRGB(88, 101, 242); fs.Thickness = 1.5; fs.Parent = frame

    local mTitle = Instance.new("TextLabel")
    mTitle.Size = UDim2.new(1, 0, 0, 40)
    mTitle.BackgroundTransparency = 1
    mTitle.Text = "Select Quest Runner Mode"
    mTitle.TextColor3 = Color3.fromRGB(240, 243, 255)
    mTitle.Font = Enum.Font.GothamBold
    mTitle.TextSize = 14
    mTitle.Parent = frame

    local qBtn = Instance.new("TextButton")
    qBtn.Size = UDim2.new(0.9, 0, 0, 55)
    qBtn.Position = UDim2.fromOffset(17, 50)
    qBtn.BackgroundColor3 = Color3.fromRGB(46, 160, 90)
    qBtn.Text = "📜 QUEST MODE\nFarms Quests, Buys Cubes & Breaks Chests"
    qBtn.TextColor3 = Color3.new(1, 1, 1)
    qBtn.Font = Enum.Font.GothamBold
    qBtn.TextSize = 11
    qBtn.Parent = frame
    local qc = Instance.new("UICorner"); qc.CornerRadius = UDim.new(0, 8); qc.Parent = qBtn

    qBtn.MouseButton1Click:Connect(function()
        CONFIG.MODE = "QUEST"
        CONFIG.RUNNING = true
        modalGui:Destroy()
        addLog("Mode selected: QUEST MODE")
    end)

    local hBtn = Instance.new("TextButton")
    hBtn.Size = UDim2.new(0.9, 0, 0, 55)
    hBtn.Position = UDim2.fromOffset(17, 118)
    hBtn.BackgroundColor3 = Color3.fromRGB(130, 70, 230)
    hBtn.Text = "💎 HUGE MODE\nServer Hops for Boss Chests & Rare Huges"
    hBtn.TextColor3 = Color3.new(1, 1, 1)
    hBtn.Font = Enum.Font.GothamBold
    hBtn.TextSize = 11
    hBtn.Parent = frame
    local hc = Instance.new("UICorner"); hc.CornerRadius = UDim.new(0, 8); hc.Parent = hBtn

    hBtn.MouseButton1Click:Connect(function()
        CONFIG.MODE = "HUGE"
        CONFIG.RUNNING = true
        modalGui:Destroy()
        addLog("Mode selected: HUGE MODE")
    end)
end

--------------------------------------------------------------------------------
-- SECTION 11: Main Execution Entrypoint
--------------------------------------------------------------------------------
local function main()
    buildUI()
    promptModeSelection()
    executeMainLoop()
    addLog("Runner v3.2.0 initialized cleanly.")
end

local ok, err = xpcall(main, debug.traceback)
if not ok then warn("[EQR Fatal]: " .. tostring(err)) end
