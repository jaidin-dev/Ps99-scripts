local function getFormattedRuntime()
    local elapsed = os.time() - STATS.StartTime
    local hours = math.floor(elapsed / 3600)
    local mins = math.floor((elapsed % 3600) / 60)
    local secs = elapsed % 60
    return string.format("%02d:%02d:%02d", hours, mins, secs)
end

local function getCatchPercent()
    local total = STATS.PetsCaught + STATS.PetsEscaped
    if total == 0 then return "0%" end
    return string.format("%.1f%%", (STATS.PetsCaught / total) * 100)
end

local function getCubesPerHour()
    local elapsed = os.time() - STATS.StartTime
    if elapsed < 60 then return "-" end
    local rate = (STATS.CubesSpent / elapsed) * 3600
    return string.format("%.0f/hr", rate)
end

local function addLog(msg)
    local entry = string.format("[%s] %s", os.date("%H:%M:%S"), msg)
    table.insert(LOG_ENTRIES, 1, entry)
    if #LOG_ENTRIES > MAX_LOG_ENTRIES then
        table.remove(LOG_ENTRIES, #LOG_ENTRIES)
    end
    if GUI_REF.logLabel then
        GUI_REF.logLabel.Text = table.concat(LOG_ENTRIES, "\n")
    end
    print("[EQR] " .. msg)
end

local TeleportService = game:GetService("TeleportService")

local function serverHop()
    if IS_HOPPING then
        addLog("Already hopping, skipping")
        return false
    end

    IS_HOPPING = true
    rememberServerId(game.JobId)

    local hopReason = CONFIG.MODE == "HUGE"
        and "Chest checked; searching for a fresh server"
        or "Searching for a fresh server"

    addLog(hopReason)
    if setStage then setStage("SERVER HOP", "Scanning for an unvisited server") end

    if sendWebhook and WEBHOOK_COLORS then
        sendWebhook(
            "Server Hopping",
            hopReason .. ".",
            WEBHOOK_COLORS.BLUE
        )
    end

    local placeId = game.PlaceId
    local currentJobId = game.JobId

    local function fetchServerPage(cursor)
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
            placeId
        )

        if cursor then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local response

        if game.HttpGet then
            local ok, body = pcall(function()
                return game:HttpGet(url)
            end)

            if ok then
                response = body
            end
        end

        if not response then
            local requestFunction =
                (syn and syn.request)
                or (http and http.request)
                or http_request
                or request

            if requestFunction and type(requestFunction) == "function" then
                local ok, result = pcall(function()
                    return requestFunction({
                        Url = url,
                        Method = "GET",
                    })
                end)

                if ok and result then
                    response = result.Body or result.body
                end
            end
        end

        if not response or response == "" then
            return nil
        end

        local decodeOk, decoded = pcall(function()
            return HttpService:JSONDecode(response)
        end)

        return decodeOk and decoded or nil
    end

    local freshServerIds = {}
    local recentCandidates = {}
    local cursor = nil
    local pagesChecked = 0

    repeat
        local page = fetchServerPage(cursor)

        if not page then
            addLog("Could not fetch public server list")
            break
        end

        pagesChecked = pagesChecked + 1

        for _, server in ipairs(page.data or {}) do
            local serverId = server.id
            local playing = tonumber(server.playing) or 0
            local maxPlayers = tonumber(server.maxPlayers) or 0

            if serverId
                and serverId ~= currentJobId
                and playing < maxPlayers then

                if isRecentServer(serverId) then
                    table.insert(recentCandidates, serverId)
                else
                    table.insert(freshServerIds, serverId)
                end
            end
        end

        cursor = page.nextPageCursor
    until #freshServerIds > 0 or not cursor or pagesChecked >= SERVER_SCAN_PAGE_LIMIT

    -- If all scanned servers are inside the 20-server window, expire the
    -- oldest half and select only from IDs that are no longer recent.
    if #freshServerIds == 0 and #recentCandidates > 0 then
        local expireCount = math.min(10, math.floor(#SERVER_HISTORY / 2))
        for _ = 1, expireCount do
            table.remove(SERVER_HISTORY, 1)
        end
        syncServerHistorySession()

        for _, serverId in ipairs(recentCandidates) do
            if not isRecentServer(serverId) then
                table.insert(freshServerIds, serverId)
            end
        end

        addLog("No completely fresh server found; expired " .. expireCount .. " oldest history entries")
    end

    if #freshServerIds == 0 then
        addLog("No unvisited joinable server found; staying here and retrying")
        if setStage then setStage("SERVER HOP", "No fresh server found; retrying shortly") end
        IS_HOPPING = false
        return false
    end

    local selectedServer = freshServerIds[math.random(1, #freshServerIds)]
    rememberServerId(selectedServer)

    addLog(string.format(
        "Found %d fresh server(s); joining %s",
        #freshServerIds,
        string.sub(selectedServer, 1, 8)
    ))

    if setStage then
        setStage("SERVER HOP", "Joining " .. string.sub(selectedServer, 1, 8))
    end

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, selectedServer, player)
    end)

    IS_HOPPING = false

    if not ok then
        addLog("Teleport failed: " .. tostring(err))
        setStatus("Teleport failed: " .. tostring(err))
        return false
    end

    return true
end

local function loadConfig()
    local isFileFunc = isfile or (syn and syn.isfile)
    local readFileFunc = readfile or (syn and syn.readfile)
    if isFileFunc and readFileFunc then
        pcall(function()
            if isFileFunc(CONFIG_FILE) then
                local content = readFileFunc(CONFIG_FILE)
                if content and content ~= "" then
                    local data = HttpService:JSONDecode(content)
                    if type(data) == "table" then
                        for key, val in pairs(data) do
                            -- MODE must not survive a full Roblox restart.
                            if key ~= "MODE" and CONFIG[key] ~= nil then
                                CONFIG[key] = val
                            end
                        end
                        addLog("Config loaded")
                    end
                end
            else
                addLog("No config file, using defaults")
            end
        end)
    end
end

local function saveConfig()
    local writeFileFunc = writefile or (syn and syn.writefile)
    if writeFileFunc then
        pcall(function()
            local persistentConfig = {}
            for key, value in pairs(CONFIG) do
                -- MODE is intentionally session-only.
                if key ~= "MODE" then
                    persistentConfig[key] = value
                end
            end
            writeFileFunc(CONFIG_FILE, HttpService:JSONEncode(persistentConfig))
        end)
    end
end

loadConfig()

WEBHOOK_COLORS = {
    GREEN = 3066993,
    RED = 15158332,
    GOLD = 15844367,
    PURPLE = 10181046,
    ORANGE = 15105570,
    BLUE = 3447003,
    TEAL = 1752220,
    GRAY = 9807270,
}

sendWebhook = function(title, description, color, fields)
    if not CONFIG.WEBHOOK_URL or CONFIG.WEBHOOK_URL == "" then
        return false, "missing webhook URL"
    end
    if not string.match(CONFIG.WEBHOOK_URL, "^https?://") then
        return false, "invalid webhook URL"
    end
    if not string.match(CONFIG.WEBHOOK_URL, "discord%.com/api/webhooks")
        and not string.match(CONFIG.WEBHOOK_URL, "discordapp%.com/api/webhooks") then
        return false, "not a Discord webhook"
    end

    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req or type(req) ~= "function" then
        return false, "HTTP request function unavailable"
    end

    local embed = {
        title = title,
        description = description,
        color = color or WEBHOOK_COLORS.GREEN,
        fields = fields or {},
        footer = { text = "Quest Runner " .. VERSION .. " â€¢ " .. os.date("%X") },
        timestamp = DateTime.now():ToIsoDate(),
    }
    local payload = HttpService:JSONEncode({ embeds = { embed } })

    local ok, response = pcall(function()
        return req({
            Url = CONFIG.WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = payload,
        })
    end)

    if not ok then
        return false, response
    end

    response = response or {}
    local status = tonumber(response.StatusCode or response.Status)
    local successFlag = response.Success == true or response.success == true
    local successful = (status and status >= 200 and status < 300) or (not status and successFlag)
    return successful == true, status or response.StatusMessage or response.Message or "unknown response"
end

sendWebhookReliable = function(title, description, color, fields)
    local lastStatus

    for attempt = 1, WEBHOOK_RETRY_COUNT do
        local success, status = sendWebhook(title, description, color, fields)
        lastStatus = status

        if success then
            if attempt > 1 then
                addLog("Webhook delivered on retry " .. attempt .. ": " .. title)
            end
            return true, status
        end

        addLog(string.format(
            "Webhook attempt %d/%d failed for %s (%s)",
            attempt,
            WEBHOOK_RETRY_COUNT,
            tostring(title),
            tostring(status)
        ))

        if attempt < WEBHOOK_RETRY_COUNT then
            task.wait(0.75 * attempt)
        end
    end

    STATS.WebhookFailures = STATS.WebhookFailures + 1
    return false, lastStatus
end

local function getCubeName(forceUltra)
    if forceUltra then return "Ultra Pet Cube" end
    if CONFIG.USE_ULTRA then return "Ultra Pet Cube" end
    return "Pet Cube"
end

local function getCubeCount(forceUltra)
    local cubeName
    if forceUltra == true then
        cubeName = "Ultra Pet Cube"
    elseif forceUltra == false then
        cubeName = "Pet Cube"
    else
        cubeName = getCubeName(nil)
    end

    if MiscItem then
        local ok, item = pcall(function() return MiscItem(cubeName) end)
        if ok and item then
            local countOk, count = pcall(function() return item:CountExact() end)
            if countOk and count then return count end
        end
    end
    local data = Save and Save.Get()
    local miscInv = data and data.Inventory and data.Inventory.Misc or {}
    local count = 0
    for _, itemData in pairs(miscInv) do
        if type(itemData) == "table" and itemData.id == cubeName then
            count = count + (itemData._am or 1)
        end
    end
    return count
end

local function getQuestData()
    local data = Save and Save.Get()
    return data and data.NPCQuests and data.NPCQuests[QUEST_ID] or nil
end

local function getRequiredPets()
    local quest = getQuestData()
    local targets = {}
    for _, goal in pairs(quest and quest.Quests or {}) do
        if goal.PetID and (goal.Progress or 0) < (goal.Amount or 0) then
            targets[goal.PetID] = (goal.Amount or 0) - (goal.Progress or 0)
        end
    end
    return targets
end

local function questComplete()
    local quest = getQuestData()
    if not quest or not quest.Quests then return false end
    for _, goal in pairs(quest.Quests) do
        if (goal.Progress or 0) < (goal.Amount or 0) then return false end
    end
    return true
end

local function ensureQuestData()
    local quest = getQuestData()
    if quest and quest.Quests then return true end
    pcall(function()
        ClientNetwork.Invoke("NPC Quests: Ensure", QUEST_ID)
    end)
    return false
end

local function getRoamingPetId(entry)
    if PetItem then
        local ok, item = pcall(function() return PetItem:From(entry.Pet) end)
        if ok and item and item.GetId then return item:GetId() end
    end
    if entry and entry.Pet then
        local petId = entry.Pet.id or entry.Pet
        if type(petId) == "string" then return petId end
    end
    return nil
end

local function isRarePet(entry)
    if not entry or not entry.Pet then return false, nil, nil end
    local petId = getRoamingPetId(entry)
    if not petId then return false, nil, nil end

    local lowerName = string.lower(petId)
    if string.find(lowerName, "huge", 1, true) then
        return true, petId, "HUGE"
    end
    if PetItem then
        local ok, item = pcall(function() return PetItem:From(entry.Pet) end)
        if ok and item then
            if item.IsHuge and pcall(function() return item:IsHuge() end) and item:IsHuge() then
                return true, petId, "HUGE"
            end
        end
    end
    return false, petId, nil
end

local function isHugeInventoryPet(petData)
    if type(petData) ~= "table" then
        return false, nil
    end

    local petId = tostring(petData.id or "")
    if string.find(string.lower(petId), "huge", 1, true) then
        return true, petId
    end

    if PetItem then
        local ok, item = pcall(function()
            return PetItem:From(petData)
        end)

        if ok and item and item.IsHuge then
            local hugeOk, isHuge = pcall(function()
                return item:IsHuge()
            end)

            if hugeOk and isHuge then
                return true, petId
            end
        end
    end

    return false, petId
end

local function getPetVariant(petData)
    if not petData then return "Normal" end

    if petData.sh then return "Shiny" end
    if petData.ra then return "Rainbow" end
    if petData.g then return "Golden" end
    if petData.m then return "Machine" end
    if petData.ct then return "Dark Matter" end

    return "Normal"
end

local function chooseTarget()
    local data = Save and Save.Get()
    local roaming = data and data.RoamingPets or {}

    local roamingCount = 0
    for _ in pairs(roaming) do
        roamingCount = roamingCount + 1
    end

    for index, entry in pairs(roaming) do
        local isRare, rareName, rareType = isRarePet(entry)
        if isRare then
            return index, rareName, true, rareType
        end
    end

    local targets = getRequiredPets()
    local bestIndex, bestPet, bestScore = nil, nil, -math.huge
    for index, entry in pairs(roaming) do
        local petId = getRoamingPetId(entry)
        local remaining = petId and targets[petId]
        if remaining then
            local chance = tonumber(entry.Chance) or 0
            local score = chance * 100 + remaining
            if score > bestScore then
                bestIndex, bestPet, bestScore = index, petId, score
            end
        end
    end
    if bestIndex then
        return bestIndex, bestPet, false, nil
    end

    if roamingCount > 0 then
        addLog("Found " .. roamingCount .. " roaming pets but none match quest")
    else
        addLog("No roaming pets found")
    end

    return nil, nil, false, nil
end

local function findRarePetOnly()
    local data = Save and Save.Get()
    local roaming = data and data.RoamingPets or {}

    for index, entry in pairs(roaming) do
        local isRare, rareName, rareType = isRarePet(entry)
        if isRare then
            return index, rareName, true, rareType
        end
    end

    return nil, nil, false, nil
end

local function findHighestChancePet()
    local data = Save and Save.Get()
    local roaming = data and data.RoamingPets or {}

    local bestIndex, bestPet, bestChance = nil, nil, -1

    for index, entry in pairs(roaming) do
        local petId = getRoamingPetId(entry)
        local chance = tonumber(entry.Chance) or 0

        if chance > bestChance then
            bestIndex, bestPet, bestChance = index, petId, chance
        end
    end

    if bestIndex then
        return bestIndex, bestPet, false, nil
    end

    return nil, nil, false, nil
end

local function redeem()
    local currentCubes = getCubeCount()
    local ok, success = pcall(function()
        return ClientNetwork.Invoke("NPC Quests: Redeem", QUEST_ID)
    end)
    if ok and success then
        STATS.QuestsCompleted = STATS.QuestsCompleted + 1
        addLog("Quest " .. STATS.QuestsCompleted .. " done")
        sendWebhook(
            "Quest " .. STATS.QuestsCompleted .. " Finished",
            "Quest completed, reward claimed",
            WEBHOOK_COLORS.GREEN,
            {
                { name = "Player", value = player.Name, inline = true },
                { name = "Total Completed", value = tostring(STATS.QuestsCompleted), inline = true },
                { name = "Runtime", value = getFormattedRuntime(), inline = true },
                { name = "Pets Caught", value = tostring(STATS.PetsCaught), inline = true },
                { name = "Cubes Left", value = tostring(currentCubes) .. " " .. getCubeName(), inline = true },
                { name = "Catch Rate", value = getCatchPercent(), inline = true },
            }
        )
        return true
    end
    addLog("Quest done but claim failed, talk to NPC")
    return false
end

local function getAvailableCubeSlots()
    local data = Save and Save.Get()
    local merchantSave = data and data.MerchantPurchases and data.MerchantPurchases.PetCubeStore
    local purchases = merchantSave and merchantSave.Purchases or {}
    local storeData = Directory and Directory.Merchants and Directory.Merchants.PetCubeStore
    local offers = storeData and storeData.GetOffers and storeData:GetOffers() or {}

    local available = {}
    for slotIndex, offer in ipairs(offers) do
        local bought = purchases[tostring(slotIndex)] or purchases[slotIndex] or 0
        local maxStock = offer.Stock or 1
        if bought < maxStock then
            table.insert(available, slotIndex)
        end
    end
    return available, #offers, merchantSave and merchantSave.Seed
end

local checkAndNotifyRestock

local function getMerchantSlotPurchased(slot)
    local data = Save and Save.Get()
    local merchantSave = data and data.MerchantPurchases and data.MerchantPurchases.PetCubeStore
    local purchases = merchantSave and merchantSave.Purchases or {}
    return tonumber(purchases[tostring(slot)] or purchases[slot]) or 0
end

local function getCubeInventoryTotal()
    return getCubeCount(false) + getCubeCount(true)
end

local function getCubeOffer(slot)
    local storeData = Directory and Directory.Merchants and Directory.Merchants.PetCubeStore
    local offers = storeData and storeData.GetOffers and storeData:GetOffers() or {}
    return offers[slot]
end

local function buyAvailableCubeStock()
    if not CONFIG.AUTO_RESTOCK then return 0, 0 end

    local verifiedPurchases = 0
    local attempted = 0
    checkAndNotifyRestock()

    local slots = getAvailableCubeSlots()
    for _, slot in ipairs(slots) do
        if not CONFIG.AUTO_RESTOCK or not CONFIG.RUNNING then break end

        local now = os.clock()
        if (now - (LAST_PURCHASE_ATTEMPT[slot] or 0)) < 0.8 then
            continue
        end
        LAST_PURCHASE_ATTEMPT[slot] = now
        attempted = attempted + 1

        local beforePurchased = getMerchantSlotPurchased(slot)
        local beforeCubeTotal = getCubeInventoryTotal()
        local offer = getCubeOffer(slot)

        if setStage then
            setStage("SHOP", "Buying cube slot " .. tostring(slot))
        end

        local invokeOk, response = pcall(function()
            return ClientNetwork.Invoke("Merchant_RequestPurchase", PET_CUBE_STORE_ID, slot)
        end)

        local confirmed = false
        local afterPurchased = beforePurchased
        local verificationDeadline = os.clock() + 1.25

        repeat
            task.wait(0.1)
            afterPurchased = getMerchantSlotPurchased(slot)
            local afterCubeTotal = getCubeInventoryTotal()

            if afterPurchased > beforePurchased or afterCubeTotal > beforeCubeTotal then
                confirmed = true
                break
            end
        until os.clock() >= verificationDeadline or not CONFIG.RUNNING

        if confirmed then
            local purchaseDelta = math.max(1, afterPurchased - beforePurchased)
            local price = tonumber(offer and offer.Price) or 0
            local quantity = tonumber(offer and offer.Quantity) or 1

            STATS.DiamondsSpent = STATS.DiamondsSpent + (price * purchaseDelta)
            STATS.CubesBought = STATS.CubesBought + (quantity * purchaseDelta)
            verifiedPurchases = verifiedPurchases + purchaseDelta
            addLog(string.format("Verified cube purchase: slot %d x%d", slot, purchaseDelta))
        else
            STATS.PurchaseRetries = STATS.PurchaseRetries + 1
            addLog(string.format(
                "Cube slot %d was not verified (%s); it will retry during this shop visit",
                slot,
                invokeOk and tostring(response) or "remote error"
            ))
        end
    end

    return verifiedPurchases, attempted
end

local function getRootPart()
    local character = player.Character or player.CharacterAdded:Wait()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function movePlayer(targetCFrame, statusText)
    local root = getRootPart()
    if not root or not targetCFrame then
        addLog("Teleport failed: HumanoidRootPart missing")
        return false
    end

    if statusText then
        setStatus(statusText)
    end

    root.CFrame = targetCFrame
    task.wait(0.65)
    return true
end

local function visitShopAndBuy(returnCFrame)
    if not CONFIG.AUTO_RESTOCK or IS_VISITING_SHOP then
        return false
    end

    IS_VISITING_SHOP = true
    local moved = movePlayer(SHOP_CFRAME, "Going to cube shop")
    local verifiedTotal = 0

    if moved then
        local shopArrivalTime = os.clock()
        addLog("At cube shop; verifying purchases for " .. SHOP_STAY_DURATION .. " seconds")
        task.wait(0.35)

        while CONFIG.RUNNING and (os.clock() - shopArrivalTime) < SHOP_STAY_DURATION do
            local root = getRootPart()
            if root then
                root.CFrame = SHOP_CFRAME
            end

            local bought = buyAvailableCubeStock()
            verifiedTotal = verifiedTotal + (bought or 0)

            local remaining = math.max(0, SHOP_STAY_DURATION - (os.clock() - shopArrivalTime))
            if setStage then
                setStage(
                    "SHOP",
                    string.format("Verified %d purchase(s) â€¢ %.1fs remaining", verifiedTotal, remaining)
                )
            end
            task.wait(math.min(0.55, math.max(0.05, remaining)))
        end

        addLog("Shop visit finished with " .. verifiedTotal .. " verified purchase(s)")
    end

    if returnCFrame then
        movePlayer(returnCFrame, "Returning to farming zone")
    end

    IS_VISITING_SHOP = false
    return moved, verifiedTotal
end

checkAndNotifyRestock = function()
    local data = Save and Save.Get()
    local merchantSave = data and data.MerchantPurchases and data.MerchantPurchases.PetCubeStore
    if not merchantSave then return false end

    local currentSeed = merchantSave.Seed
    if currentSeed and currentSeed ~= LAST_RESTOCK_SEED then
        if LAST_RESTOCK_SEED ~= nil then
            addLog("Cube store restocked")
            sendWebhook(
                "Cube Store Restocked",
                "Pet Cube Store refreshed",
                WEBHOOK_COLORS.BLUE,
                {
                    { name = "Your Cubes", value = tostring(getCubeCount()) .. " " .. getCubeName(), inline = true },
                    { name = "Runtime", value = getFormattedRuntime(), inline = true },
                }
            )
        end
        LAST_RESTOCK_SEED = currentSeed
        return true
    end
    return false
end

local function autoEatFruits()
    if not FruitCmds then return end
    local fruitTypes = { "Apple", "Banana", "Orange", "Pineapple", "Watermelon", "Rainbow Fruit" }
    for _, fruit in ipairs(fruitTypes) do
        pcall(function()
            local needed = nil
            pcall(function() needed = FruitCmds:GetMaxConsume(fruit) end)
            if not needed then pcall(function() needed = FruitCmds.GetMaxConsume(fruit) end) end
            if needed and needed > 0 then
                local ok, result = pcall(function() return FruitCmds:Consume(fruit, needed) end)
                if not ok or result == false then
                    ok, result = pcall(function() return FruitCmds.Consume(fruit, needed) end)
                end
                if ok and result ~= false then
                    STATS.FruitsEaten = STATS.FruitsEaten + needed
                end
            end
        end)
    end
end

local IS_BOSS_CHEST_ACTIVE = false
local LAST_BOSS_CHEST_ID = nil

local function checkForBossChest()
    local things = game:GetService("Workspace"):FindFirstChild("__THINGS")
    local breakables = things and things:FindFirstChild("Breakables")
    if not breakables then return nil end

    for _, model in ipairs(breakables:GetChildren()) do
        if model:IsA("Model") then
            local pos = model:GetPivot().Position
            local distToBoss = (pos - BOSS_CHEST_SPAWN_POS).Magnitude
            if distToBoss < 25 then
                return model
            end
        end
    end
    return nil
end

local function autoBreakChests()
    pcall(function()
        local player = game.Players.LocalPlayer
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

        local net = game:GetService("ReplicatedStorage"):FindFirstChild("Network")
        local damageRemote = net and net:FindFirstChild("Breakables_PlayerDealDamage")

        local things = game:GetService("Workspace"):FindFirstChild("__THINGS")
        local breakables = things and things:FindFirstChild("Breakables")

        if not breakables or not damageRemote then return end

        for _, model in ipairs(breakables:GetChildren()) do
            if model:IsA("Model") then
                local pos = model:GetPivot().Position
                local distToPlayer = root and (pos - root.Position).Magnitude or 9999
                local distToBoss = (pos - BOSS_CHEST_SPAWN_POS).Magnitude

                if distToBoss >= 25 and distToPlayer < 50 then
                    damageRemote:FireServer(model.Name)
                end
            end
        end
    end)
end

local function sendSummaryDigest(isManual)
    local normalCubes = getCubeCount(false)
    local ultraCubes = getCubeCount(true)
    local success, status = sendWebhook(
        isManual and "Session Summary" or "Hourly Update",
        "Session stats:",
        WEBHOOK_COLORS.TEAL,
        {
            { name = "Runtime", value = getFormattedRuntime(), inline = true },
            { name = "Quests", value = tostring(STATS.QuestsCompleted), inline = true },
            { name = "Pets Caught", value = tostring(STATS.PetsCaught), inline = true },
            { name = "Catch Rate", value = getCatchPercent(), inline = true },
            { name = "Cubes Used", value = tostring(STATS.CubesSpent), inline = true },
            { name = "Cubes/Hour", value = getCubesPerHour(), inline = true },
            { name = "Normal Cubes", value = tostring(normalCubes) .. " ", inline = true },
            { name = "Ultra Cubes", value = tostring(ultraCubes) .. " ", inline = true },
            { name = "Diamonds Spent", value = tostring(STATS.DiamondsSpent) .. " ", inline = true },
            { name = "Huge Catches", value = tostring(STATS.RareCatches) .. " ", inline = true },
            { name = "Servers Remembered", value = tostring(#SERVER_HISTORY), inline = true },
            { name = "Fruits Eaten", value = tostring(STATS.FruitsEaten), inline = true },
        }
    )
    LAST_SUMMARY_TIME = os.time()
    addLog(success and (isManual and "Summary sent" or "Hourly update sent")
        or ("Summary failed: " .. tostring(status)))
    return success, status
end

local function sendInventoryAlert()
    local normalCubes = getCubeCount(false)
    local ultraCubes = getCubeCount(true)
    addLog(string.format("Cubes: %d normal | %d ultra", normalCubes, ultraCubes))
    local success, status = sendWebhook(
        "Inventory Check",
        string.format("Normal: **%d**\nUltra: **%d**\nTime: %s", normalCubes, ultraCubes, getFormattedRuntime()),
        WEBHOOK_COLORS.BLUE,
        {
            { name = "Quests Done", value = tostring(STATS.QuestsCompleted), inline = true },
            { name = "Pets Caught", value = tostring(STATS.PetsCaught), inline = true },
            { name = "Cubes/Hour", value = getCubesPerHour(), inline = true },
        }
    )
    if not success then
        addLog("Inventory alert failed (status: " .. tostring(status) .. ")")
    end
end

