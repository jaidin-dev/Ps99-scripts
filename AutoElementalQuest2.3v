    shopToggle.Text = "Auto Restock: " .. (CONFIG.AUTO_RESTOCK and "ON" or "OFF")
    shopToggle.TextColor3 = CONFIG.AUTO_RESTOCK and Color3.fromRGB(160, 220, 255) or Color3.fromRGB(150, 155, 170)
    shopToggle.Font = Enum.Font.GothamMedium
    shopToggle.TextSize = 10
    shopToggle.Parent = mainFrame
    local stC = Instance.new("UICorner"); stC.CornerRadius = UDim.new(0, 5); stC.Parent = shopToggle

    shopToggle.MouseButton1Click:Connect(function()
        CONFIG.AUTO_RESTOCK = not CONFIG.AUTO_RESTOCK
        shopToggle.Text = "Auto Restock: " .. (CONFIG.AUTO_RESTOCK and "ON" or "OFF")
        shopToggle.BackgroundColor3 = CONFIG.AUTO_RESTOCK and Color3.fromRGB(40, 50, 75) or Color3.fromRGB(25, 28, 40)
        shopToggle.TextColor3 = CONFIG.AUTO_RESTOCK and Color3.fromRGB(160, 220, 255) or Color3.fromRGB(150, 155, 170)
        saveConfig()
    end)

    -- Stats Display Panel
    local statsGrid = Instance.new("Frame")
    statsGrid.Size = UDim2.new(1, -24, 0, 120)
    statsGrid.Position = UDim2.fromOffset(12, 114)
    statsGrid.BackgroundColor3 = Color3.fromRGB(20, 23, 34)
    statsGrid.Parent = mainFrame
    local sgC = Instance.new("UICorner"); sgC.CornerRadius = UDim.new(0, 8); sgC.Parent = statsGrid

    local statsLabel = Instance.new("TextLabel")
    statsLabel.Size = UDim2.new(1, -16, 1, -12)
    statsLabel.Position = UDim2.fromOffset(8, 6)
    statsLabel.BackgroundTransparency = 1
    statsLabel.Text = "Initializing stats..."
    statsLabel.TextColor3 = Color3.fromRGB(200, 212, 238)
    statsLabel.Font = Enum.Font.Code
    statsLabel.TextSize = 11
    statsLabel.TextXAlignment = Enum.TextXAlignment.Left
    statsLabel.TextYAlignment = Enum.TextYAlignment.Top
    statsLabel.Parent = statsGrid

    table.insert(StateMachine.UIListeners, function(state, detail)
        statusPill.Text = string.upper(state) .. " • " .. string.sub(detail, 1, 14)
        local elapsed = os.time() - STATS.StartTime
        statsLabel.Text = string.format(
            "Runtime:      %02d:%02d:%02d\n" ..
            "Quests Done:  %d\n" ..
            "Pets Caught:  %d\n" ..
            "Chests Broke: %d\n" ..
            "Cubes Left:   %d %s\n" ..
            "Priority:     Easiest Quest Target First",
            math.floor(elapsed / 3600), math.floor((elapsed % 3600) / 60), elapsed % 60,
            STATS.QuestsCompleted,
            STATS.PetsCaught,
            STATS.ChestsBroken,
            getCubeCount(), getCubeName()
        )
    end)
end

--------------------------------------------------------------------------------
-- SECTION 10: Entrypoint
--------------------------------------------------------------------------------
local function main()
    buildUI()
    executeMainLoop()
    print("[EQR v3.1.0] Sleek Compact Runner loaded cleanly.")
end

local ok, err = xpcall(main, debug.traceback)
if not ok then warn("[EQR Fatal]: " .. tostring(err)) end
