setCollapsed = function(value)
    collapsed = value == true
    minBtn.Text = collapsed and "+" or "-"

    if tabsBar then tabsBar.Visible = not collapsed end
    if statusFooter then statusFooter.Visible = not collapsed end
    if userFooter then userFooter.Visible = not collapsed end

    if tabFrames then
        for idx, tf in pairs(tabFrames) do
            tf.Visible = not collapsed and (tabActiveState[idx] == true)
        end
    end

    panel.Size = collapsed
        and UDim2.fromOffset(PW, mobile and 36 or 42)
        or UDim2.fromOffset(PW, PH)

    shadow.Size = collapsed
        and UDim2.fromOffset(PW + 14, (mobile and 36 or 42) + 14)
        or UDim2.fromOffset(PW + 14, PH + 14)
end

