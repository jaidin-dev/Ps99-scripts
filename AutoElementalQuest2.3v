local function updateStartButton()
    if CONFIG.RUNNING then
        startBtn.Text = "PAUSE"
        startBtn.BackgroundColor3 = Color3.fromRGB(175, 80, 55)
        if startBtnStroke then
            startBtnStroke.Color = Color3.fromRGB(240, 120, 80)
        end
    else
        startBtn.Text = "START"
        startBtn.BackgroundColor3 = Color3.fromRGB(46, 153, 82)
        if startBtnStroke then
            startBtnStroke.Color = Color3.fromRGB(75, 220, 120)
        end
    end
end

startBtn.MouseButton1Click:Connect(function()
    CONFIG.RUNNING = not CONFIG.RUNNING
    updateStartButton()
    updateStateBanner()
    saveConfig()
    if CONFIG.RUNNING then
        if CONFIG.MODE == "QUEST" then
            LAST_QUEST_SHOP_VISIT = os.clock()
        end
        addLog("Started")
        sendWebhook("Started", "Runner is active", WEBHOOK_COLORS.GRAY)
    else
        addLog("Paused")
        sendWebhook("Paused", "Runner stopped", WEBHOOK_COLORS.GRAY)
    end
end)

summaryBtn.MouseButton1Click:Connect(function()
    sendSummaryDigest(true)
end)

local configTab = tabFrames[2]

local function createToggleRow(parent, label, configKey, order)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, mobile and 34 or 40)
    row.BackgroundColor3 = Color3.fromRGB(24, 28, 44)
    row.LayoutOrder = order
    row.ZIndex = 3
    row.Parent = parent
    addCorner(row, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -70, 1, 0)
    lbl.Position = UDim2.fromOffset(12, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(210, 215, 230)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = FS
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 4
    lbl.Parent = row

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.fromOffset(50, mobile and 22 or 26)
    toggleBtn.Position = UDim2.new(1, -60, 0.5, mobile and -11 or -13)
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextSize = FS - 1
    toggleBtn.TextColor3 = Color3.new(1, 1, 1)
    toggleBtn.ZIndex = 5
    toggleBtn.Parent = row
    addCorner(toggleBtn, 4)

    local function updateVisual()
        local isOn = CONFIG[configKey]
        toggleBtn.Text = isOn and "ON" or "OFF"
        toggleBtn.BackgroundColor3 = isOn and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(100, 100, 120)
    end
    updateVisual()

    toggleBtn.MouseButton1Click:Connect(function()
        CONFIG[configKey] = not CONFIG[configKey]
        updateVisual()
        saveConfig()
        addLog(label .. ": " .. (CONFIG[configKey] and "on" or "off"))
    end)

    return row, toggleBtn, updateVisual
end

local function createSectionHeader(parent, text, order)
    local header = Instance.new("TextLabel")
    header.Size = UDim2.new(1, 0, 0, 22)
    header.BackgroundTransparency = 1
    header.Text = text
    header.TextColor3 = Color3.fromRGB(88, 101, 242)
    header.Font = Enum.Font.GothamBold
    header.TextSize = FS - 1
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.LayoutOrder = order
    header.ZIndex = 4
    header.Parent = parent
    return header
end

