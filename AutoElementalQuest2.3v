local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -16, 1, 0)
statusLabel.Position = UDim2.fromOffset(8, 0)
statusLabel.BackgroundTransparency = 1
statusLabel.Text = "Status: Loading game modules..."
statusLabel.TextColor3 = Color3.fromRGB(138, 230, 166)
statusLabel.Font = Enum.Font.GothamMedium
statusLabel.TextSize = FS
statusLabel.TextXAlignment = Enum.TextXAlignment.Left
statusLabel.ZIndex = 3
statusLabel.Parent = statusFooter

local function setStatus(msg)
    if statusLabel and statusLabel.Parent then
        statusLabel.Text = "Status: " .. tostring(msg)
    end
end

local function addLog(msg)
    local entry = string.format("[%s] %s", os.date("%H:%M:%S"), msg)
    table.insert(LOG_ENTRIES, 1, entry)
    if #LOG_ENTRIES > MAX_LOG_ENTRIES then
        table.remove(LOG_ENTRIES, #LOG_ENTRIES)
    end
    print("[EQR] " .. msg)
end

addLog("UI Initialized instantly! Loading game libraries...")

-- SAFE BACKGROUND MODULE LOADING
task.spawn(function()
    local Library = ReplicatedStorage:WaitForChild("Library", 15)
    if not Library then
        setStatus("Error: Game Library timeout")
        addLog("Library not found!")
        return
    end

    local Save = safeRequire(Library.Client:WaitForChild("Save", 10))
    local ClientNetwork = safeRequire(Library.Client:WaitForChild("Network", 10))
    local MapCmds = safeRequire(Library.Client:WaitForChild("MapCmds", 10))
    local Directory = safeRequire(Library.Directory)

    if not Save or not ClientNetwork or not Directory then
        setStatus("Error: Required modules failed to load")
        addLog("Modules failed to load!")
        return
    end

    setStatus("Modules loaded! Quest Runner Active")
    addLog("Modules successfully loaded.")
    CONFIG.RUNNING = true

    local function getRootPart()
        local character = player.Character or player.CharacterAdded:Wait()
        return character and character:FindFirstChild("HumanoidRootPart")
    end

    local function movePlayer(targetCFrame, statusText)
        local root = getRootPart()
        if not root or not targetCFrame then return false end
        if statusText then setStatus(statusText) end
        root.CFrame = targetCFrame
        task.wait(0.5)
        return true
    end

    local function goToElementalRealm()
        local alreadyThere = false
        pcall(function()
            alreadyThere = MapCmds and MapCmds.GetCurrentZone and MapCmds.GetCurrentZone() == "Elemental Realm"
        end)
        if alreadyThere then return true end

        setStatus("Going to Elemental Realm")
        local teleported = false
        pcall(function()
            if MapCmds and MapCmds.Teleport then MapCmds.Teleport("Elemental Realm"); teleported = true end
        end)

        if not teleported then
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then root.CFrame = ELEMENTAL_REALM_CFRAME; teleported = true end
        end

        task.wait(1.5)
        return teleported
    end

    local function getCubeCount(forceUltra)
        local cubeName = (forceUltra == true and "Ultra Pet Cube") or "Pet Cube"
        local data = Save and Save.Get()
        local miscInv = data and data.Inventory and data.Inventory.Misc or {}
        local count = 0
        for _, itemData in pairs(miscInv) do
            if type(itemData) == "table" and (itemData.id == cubeName or string.find(tostring(itemData.id or ""), cubeName, 1, true)) then
                count = count + (itemData._am or 1)
            end
        end
        return count
    end

    local function getQuestData()
        local data = Save and Save.Get()
        return data and data.NPCQuests and data.NPCQuests[QUEST_ID] or nil
    end

    local function getRequiredPets()
        local quest = getQuestData()
        local targets = {}
        for _, goal in pairs(quest and quest.Quests or {}) do
            if goal.PetID and (goal.Progress or 0) < (goal.Amount or 0) then
                targets[goal.PetID] = (goal.Amount or 0) - (goal.Progress or 0)
            end
        end
        return targets
    end

    local function getRoamingPetId(entry)
        if entry and entry.Pet then
            local petId = entry.Pet.id or entry.Pet
            if type(petId) == "string" then return petId end
        end
        return nil
    end

    local function findEasiestPet()
        local data = Save and Save.Get()
        local roaming = data and data.RoamingPets or {}
        local bestIndex, bestPet, bestChance, bestEntry = nil, nil, math.huge, nil

        for index, entry in pairs(roaming) do
            local petId = getRoamingPetId(entry)
            local chance = tonumber(entry.Chance or entry.CatchPercent) or 999999
            if chance < bestChance then
                bestIndex, bestPet, bestChance, bestEntry = index, petId, chance, entry
            end
        end
        return bestIndex, bestPet, false, nil, bestEntry
    end

    local function chooseTarget()
        local data = Save and Save.Get()
        local roaming = data and data.RoamingPets or {}
        local targets = getRequiredPets()

        for index, entry in pairs(roaming) do
            local petId = getRoamingPetId(entry)
            if petId and targets[petId] then
                return index, petId, false, nil, entry
            end
        end

        return findEasiestPet()
    end

    local function invokeCatchRemote(cubeName, index, entry)
        local ok, res = pcall(function() return ClientNetwork.Invoke("RoamingPets_CatchPet", cubeName, index) end)
        if ok and res ~= false and res ~= nil then return true, res end

        if type(index) == "string" and tonumber(index) then
            local numIdx = tonumber(index)
            ok, res = pcall(function() return ClientNetwork.Invoke("RoamingPets_CatchPet", cubeName, numIdx) end)
            if ok and res ~= false and res ~= nil then return true, res end
        end

        if type(index) == "number" then
            local strIdx = tostring(index)
            ok, res = pcall(function() return ClientNetwork.Invoke("RoamingPets_CatchPet", cubeName, strIdx) end)
            if ok and res ~= false and res ~= nil then return true, res end
        end

        if type(entry) == "table" and (entry.Index or entry.Id or entry.ID) then
            local key = entry.Index or entry.Id or entry.ID
            ok, res = pcall(function() return ClientNetwork.Invoke("RoamingPets_CatchPet", cubeName, key) end)
            if ok and res ~= false and res ~= nil then return true, res end
        end

        return false, nil
    end

    -- MAIN LOOP
    while gui.Parent and CONFIG.RUNNING do
        goToElementalRealm()

        local index, petId, isRareTarget, rareType, targetEntry = chooseTarget()

        if index and petId then
            local targetCubeName = (getCubeCount(true) > 0 and "Ultra Pet Cube") or "Pet Cube"
            setStatus("Throwing " .. targetCubeName .. " at " .. tostring(petId))

            local ok, accepted = invokeCatchRemote(targetCubeName, index, targetEntry)
            if ok then
                STATS.PetsCaught = STATS.PetsCaught + 1
                addLog("Caught " .. tostring(petId) .. "! Total: " .. STATS.PetsCaught)
                setStatus("Caught " .. tostring(petId) .. "! Total: " .. STATS.PetsCaught)
            else
                addLog("Catch attempt finished for " .. tostring(petId))
            end
        else
            setStatus("Waiting for pets...")
        end

        task.wait(CATCH_DELAY)
    end
end)

print("[EQR " .. VERSION .. "] Script & GUI initialized successfully!")
