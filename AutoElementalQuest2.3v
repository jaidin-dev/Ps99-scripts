--[[
    Elemental Quest Runner v3.0.0 (Professional Architecture Refactor)
    ------------------------------------------------------------------
    - Singleton Runtime Cleanup (_G.EQR_RUNTIME)
    - Authoritative State Machine Architecture
    - Non-Blocking Asynchronous Webhook Queue
    - Strict Boss Chest & Huge Detection Engine
    - Robust Server Hop & Queue-On-Teleport Loader
    - Modern Responsive Dashboard UI
--]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local VirtualUser = game:GetService("VirtualUser")
local TeleportService = game:GetService("TeleportService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--------------------------------------------------------------------------------
-- SECTION 1: EQR_Runtime (Singleton & Cleanup Manager)
--------------------------------------------------------------------------------
local previousRuntime = _G.EQR_RUNTIME
if previousRuntime and type(previousRuntime.Cleanup) == "function" then
    pcall(function()
        previousRuntime:Cleanup()
    end)
end

local EQR_RUNTIME = {
    Version = "v3.0.0",
    RunId = (previousRuntime and previousRuntime.RunId or 0) + 1,
    Connections = {},
    Tasks = {},
    IsActive = true,
}

_G.EQR_RUNTIME = EQR_RUNTIME

function EQR_RUNTIME:AddConnection(connection)
    if typeof(connection) == "RBXScriptConnection" then
        table.insert(self.Connections, connection)
    end
    return connection
end

function EQR_RUNTIME:SpawnTask(fn)
    local taskThread = task.spawn(function(...)
        if self.IsActive then
            fn(...)
        end
    end)
    table.insert(self.Tasks, taskThread)
    return taskThread
end

function EQR_RUNTIME:Cleanup()
    self.IsActive = false
    print("[EQR] Cleaning up previous runtime instance #" .. tostring(self.RunId))
    
    for _, conn in ipairs(self.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(self.Connections)

    for _, t in ipairs(self.Tasks) do
        pcall(function() task.cancel(t) end)
    end
    table.clear(self.Tasks)

    local oldGui = playerGui:FindFirstChild("EQR_Pro")
    if oldGui then oldGui:Destroy() end

    local oldSelector = playerGui:FindFirstChild("ModeSelector")
    if oldSelector then oldSelector:Destroy() end
end

local function isCurrentRun(runId)
    return EQR_RUNTIME.IsActive and EQR_RUNTIME.RunId == runId
end

--------------------------------------------------------------------------------
-- SECTION 2: ConfigManager & Schema Validation
--------------------------------------------------------------------------------
local CONFIG_FILE = "ElementalQuestRunner_Config.json"

local CONFIG_SCHEMA = {
    RUNNING = "boolean",
    MODE = "string",
    USE_ULTRA = "boolean",
    AUTO_RESTOCK = "boolean",
    AUTO_FRUITS = "boolean",
    AUTO_BREAK = "boolean",
    ALERT_RARE = "boolean",
    ALERT_LOW_CUBES = "boolean",
    CUBE_ALERT_THRESHOLD = "number",
    WEBHOOK_URL = "string",
}

local CONFIG = {
    RUNNING = false,
    MODE = "QUEST",
    USE_ULTRA = false,
    AUTO_RESTOCK = true,
    AUTO_FRUITS = true,
    AUTO_BREAK = true,
    ALERT_RARE = true,
    ALERT_LOW_CUBES = true,
    CUBE_ALERT_THRESHOLD = 50,
    WEBHOOK_URL = "",
}

local function validateConfig(data)
    if type(data) ~= "table" then return false end
    for key, expectedType in pairs(CONFIG_SCHEMA) do
        if data[key] ~= nil then
            if type(data[key]) ~= expectedType then
                return false
            end
            if key == "MODE" and data[key] ~= "QUEST" and data[key] ~= "HUGE" then
                return false
            end
            if key == "CUBE_ALERT_THRESHOLD" and (data[key] < 1 or data[key] > 9999) then
                return false
            end
        end
    end
    return true
end

local function loadConfig()
    local isFileFunc = isfile or (syn and syn.isfile)
    local readFileFunc = readfile or (syn and syn.readfile)
    if isFileFunc and readFileFunc then
        local ok, err = pcall(function()
            if isFileFunc(CONFIG_FILE) then
                local content = readFileFunc(CONFIG_FILE)
                if content and content ~= "" then
                    local data = HttpService:JSONDecode(content)
                    if validateConfig(data) then
                        for key, val in pairs(data) do
                            if key ~= "MODE" and key ~= "RUNNING" then
                                CONFIG[key] = val
                            end
                        end
                        print("[EQR] Configuration loaded successfully.")
                    else
                        warn("[EQR] Invalid config format; using defaults.")
                    end
                end
            end
        end)
        if not ok then
            warn("[EQR] Config load error: " .. tostring(err))
        end
    end
end

local function saveConfig()
    local writeFileFunc = writefile or (syn and syn.writefile)
    if writeFileFunc then
        pcall(function()
            local persistentConfig = {}
            for key, value in pairs(CONFIG) do
                if key ~= "MODE" and key ~= "RUNNING" then
                    persistentConfig[key] = value
                end
            end
            writeFileFunc(CONFIG_FILE, HttpService:JSONEncode(persistentConfig))
        end)
    end
end

loadConfig()

--------------------------------------------------------------------------------
-- SECTION 3: WebhookService (Async Event Queue & Rate Limit Handler)
--------------------------------------------------------------------------------
local WebhookService = {
    Queue = {},
    IsProcessing = false,
    RateLimitUntil = 0,
}

local WEBHOOK_COLORS = {
    GREEN = 3066993,
    RED = 15158332,
    GOLD = 15844367,
    PURPLE = 10181046,
    ORANGE = 15105570,
    BLUE = 3447003,
    TEAL = 1752220,
    GRAY = 9807270,
}

function WebhookService:Push(title, description, color, fields, isReliable)
    if not CONFIG.WEBHOOK_URL or CONFIG.WEBHOOK_URL == "" then return end
    if not string.match(CONFIG.WEBHOOK_URL, "^https?://") then return end
    
    table.insert(self.Queue, {
        Title = title,
        Description = description,
        Color = color or WEBHOOK_COLORS.GREEN,
        Fields = fields or {},
        Reliable = isReliable == true,
        Attempts = 0,
        Timestamp = os.time()
    })

    self:ProcessQueue()
end

function WebhookService:ProcessQueue()
    if self.IsProcessing then return end
    self.IsProcessing = true

    EQR_RUNTIME:SpawnTask(function()
        local req = (syn and syn.request) or (http and http.request) or http_request or request

        while #self.Queue > 0 and EQR_RUNTIME.IsActive do
            if os.clock() < self.RateLimitUntil then
                task.wait(math.max(0.5, self.RateLimitUntil - os.clock()))
            end

            local item = self.Queue[1]
            if not item then break end

            item.Attempts = item.Attempts + 1

            local embed = {
                title = item.Title,
                description = item.Description,
                color = item.Color,
                fields = item.Fields,
                footer = { text = "Quest Runner " .. EQR_RUNTIME.Version .. " • " .. os.date("%X") },
                timestamp = DateTime.now():ToIsoDate(),
            }
            local payload = HttpService:JSONEncode({ embeds = { embed } })

            local ok, response = pcall(function()
                return req({
                    Url = CONFIG.WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = payload,
                })
            end)

            local status = ok and tonumber(response.StatusCode or response.Status) or 0
            local success = (status >= 200 and status < 300)

            if status == 429 then
                local retryAfter = 5
                pcall(function()
                    local decoded = HttpService:JSONDecode(response.Body or response.body or "{}")
                    retryAfter = tonumber(decoded.retry_after) or retryAfter
                end)
                self.RateLimitUntil = os.clock() + retryAfter
                print("[EQR Webhook] Rate limited (429). Pausing for " .. tostring(retryAfter) .. "s")
                task.wait(retryAfter)
            elseif success then
                table.remove(self.Queue, 1)
            else
                if item.Reliable and item.Attempts < 3 then
                    task.wait(1.5 * item.Attempts)
                else
                    table.remove(self.Queue, 1)
                    print("[EQR Webhook] Alert failed after " .. item.Attempts .. " attempts: " .. tostring(item.Title))
                end
            end

            task.wait(0.2)
        end

        self.IsProcessing = false
    end)
end

