updateServerHistoryUI = function()
    if not GUI_REF.serverHistoryLabel or not GUI_REF.serverHistoryLabel.Parent then
        return
    end

    local lines = {}
    for index = #SERVER_HISTORY, 1, -1 do
        local newestNumber = #SERVER_HISTORY - index + 1
        local serverId = SERVER_HISTORY[index]
        table.insert(lines, string.format("%02d  %s", newestNumber, string.sub(serverId, 1, 12)))
    end

    GUI_REF.serverHistoryLabel.Text = #lines > 0
        and table.concat(lines, "\n")
        or "No servers recorded"
end

local function updateStatsTab()
    GUI_REF.statRuntime.Text = getFormattedRuntime()
    GUI_REF.statQuests.Text = tostring(STATS.QuestsCompleted)
    GUI_REF.statCaught.Text = tostring(STATS.PetsCaught)
    GUI_REF.statEscaped.Text = tostring(STATS.PetsEscaped)
    GUI_REF.statCatchRate.Text = getCatchPercent()
    GUI_REF.statCubesUsed.Text = tostring(STATS.CubesSpent)
    GUI_REF.statCubesHour.Text = getCubesPerHour()
    GUI_REF.statDiamonds.Text = string.format("%s ", tostring(STATS.DiamondsSpent))
    GUI_REF.statRare.Text = tostring(STATS.RareCatches)
    GUI_REF.statNormalCubes.Text = tostring(getCubeCount(false))
    GUI_REF.statUltraCubes.Text = tostring(getCubeCount(true))
    GUI_REF.statBundles.Text = tostring(STATS.BundlesOpened)
    GUI_REF.statFruits.Text = tostring(STATS.FruitsEaten)
    GUI_REF.statFlags.Text = tostring(STATS.FlagsPlaced)
    GUI_REF.statChests.Text = tostring(STATS.ChestsBroken)
    GUI_REF.statCubesBought.Text = tostring(STATS.CubesBought)
    GUI_REF.statPurchaseRetries.Text = tostring(STATS.PurchaseRetries)
    GUI_REF.statWebhookFailures.Text = tostring(STATS.WebhookFailures)
    GUI_REF.statServersVisited.Text = tostring(#SERVER_HISTORY) .. "/" .. tostring(SERVER_HISTORY_LIMIT)
    if updateServerHistoryUI then updateServerHistoryUI() end
end

