local Library = ReplicatedStorage:WaitForChild("Library", 10)
if not Library then
    warn("[EQR] Library module missing from ReplicatedStorage!")
    return
end

local function safeRequire(path)
    local ok, result = pcall(require, path)
    return ok and result or nil
end

local Save = safeRequire(Library.Client:WaitForChild("Save"))
local ClientNetwork = safeRequire(Library.Client:WaitForChild("Network"))
local MapCmds = safeRequire(Library.Client:WaitForChild("MapCmds"))
local Directory = safeRequire(Library.Directory)
local FruitCmds = Library.Client:FindFirstChild("FruitCmds") and safeRequire(Library.Client.FruitCmds) or nil
local MiscItem = Library.Items and Library.Items:FindFirstChild("MiscItem") and safeRequire(Library.Items.MiscItem) or nil
local PetItem = Library.Items and Library.Items:FindFirstChild("PetItem") and safeRequire(Library.Items.PetItem) or nil

if not Save or not ClientNetwork or not Directory then
    warn("[EQR] Core client modules failed to load.")
    return
end

local QUEST_ID = "ElementalQuests"
local SCRIPT_URL = "https://raw.githubusercontent.com/jaidin-dev/Ps99-scripts/refs/heads/main/AutoElementalQuest.lua"
local ELEMENTAL_REALM_CFRAME = CFrame.new(1427.29, 17.5, -24949.01)
local FARM_ZONE_CFRAME = CFrame.new(1427.29, 17.5, -24949.01)
local SHOP_CFRAME = CFrame.new(783.183655, 19.5289688, -24890.543, -0.999179542, 2.65699146e-05, -0.0404994301, 5.14089379e-06, 0.999999881, 0.000529223063, 0.0404994413, 0.000528580684, -0.999179423)
local BOSS_CHEST_CFRAME = CFrame.new(1434.06567, 20.199398, -24874.4395, 0.271742523, 0.000449937157, 0.962369859, -0.00167914852, 0.999998569, 6.60821979e-06, -0.962368548, -0.00161775772, 0.27174291)
local BOSS_CHEST_SPAWN_POS = BOSS_CHEST_CFRAME.Position
local BOSS_CHEST_LOOT_CFRAME = BOSS_CHEST_CFRAME
local PET_CUBE_STORE_ID = "PetCubeStore"

local STATS = {
    StartTime = os.time(),
    QuestsCompleted = 0,
    PetsCaught = 0,
    PetsEscaped = 0,
    CubesSpent = 0,
    DiamondsSpent = 0,
    RareCatches = 0,
    FruitsEaten = 0,
    ChestsBroken = 0,
    CubesBought = 0,
    PurchaseRetries = 0,
    WebhookFailures = 0,
    HugeCatchAttempts = 0,
}

local function getCubeName(forceUltra)
    if forceUltra == true then return "Ultra Pet Cube" end
    if forceUltra == false then return "Pet Cube" end
    return CONFIG.USE_ULTRA and "Ultra Pet Cube" or "Pet Cube"
end

local function getCubeCount(forceUltra)
    local cubeName = getCubeName(forceUltra)
    if MiscItem then
        local ok, item = pcall(function() return MiscItem(cubeName) end)
        if ok and item then
            local countOk, count = pcall(function() return item:CountExact() end)
            if countOk and count then return count end
        end
    end
    local data = Save and Save.Get()
    local miscInv = data and data.Inventory and data.Inventory.Misc or {}
    local count = 0
    for _, itemData in pairs(miscInv) do
        if type(itemData) == "table" and itemData.id == cubeName then
            count = count + (itemData._am or 1)
        end
    end
    return count
end

local function getQuestData()
    local data = Save and Save.Get()
    return data and data.NPCQuests and data.NPCQuests[QUEST_ID] or nil
end

local function getRequiredPets()
    local quest = getQuestData()
    local targets = {}
    for _, goal in pairs(quest and quest.Quests or {}) do
        if goal.PetID and (goal.Progress or 0) < (goal.Amount or 0) then
            local remaining = (goal.Amount or 0) - (goal.Progress or 0)
            targets[goal.PetID] = (targets[goal.PetID] or 0) + remaining
        end
    end
    return targets
end

local function questComplete()
    local quest = getQuestData()
    if not quest or not quest.Quests or #quest.Quests == 0 then return false end
    for _, goal in pairs(quest.Quests) do
        if (goal.Progress or 0) < (goal.Amount or 0) then return false end
    end
    return true
end

local function ensureQuestData()
    local quest = getQuestData()
    if quest and quest.Quests and #quest.Quests > 0 then return true end
    pcall(function()
        ClientNetwork.Invoke("NPC Quests: Ensure", QUEST_ID)
    end)
    return false
end

local function getRoamingPetId(entry)
    if PetItem then
        local ok, item = pcall(function() return PetItem:From(entry.Pet) end)
        if ok and item and item.GetId then return item:GetId() end
    end
    if entry and entry.Pet then
        local petId = entry.Pet.id or entry.Pet
        if type(petId) == "string" then return petId end
    end
    return nil
end

local function getCatchDifficulty(entry)
    local chance = tonumber(entry and entry.Chance)
    if not chance or chance <= 0 then
        return 999999
    end
    return chance
end

--------------------------------------------------------------------------------
-- SECTION 5: BossChest & Huge Detection Engine (Strict Identification)
--------------------------------------------------------------------------------
local BossChestService = {}

function BossChestService:GetBossChest()
    local things = workspace:FindFirstChild("__THINGS")
    local breakables = things and things:FindFirstChild("Breakables")
    if not breakables then return nil end

    for _, model in ipairs(breakables:GetChildren()) do
        if model:IsA("Model") then
            local pos = model:GetPivot().Position
            local dist = (pos - BOSS_CHEST_SPAWN_POS).Magnitude
            if dist < 25 then
                local modelName = string.lower(model.Name)
                local isBossType = string.find(modelName, "boss", 1, true)
                    or string.find(modelName, "chest", 1, true)
                    or string.find(modelName, "elemental", 1, true)
                    or model:GetAttribute("IsBoss") == true
                
                if isBossType then
                    return model
                end
            end
        end
    end
    return nil
end

local function isRarePet(entry)
    if not entry or not entry.Pet then return false, nil, nil end
    local petId = getRoamingPetId(entry)
    if not petId then return false, nil, nil end

    local lowerName = string.lower(petId)
    if string.find(lowerName, "huge", 1, true) then
        return true, petId, "HUGE"
    end

    if PetItem then
        local ok, item = pcall(function() return PetItem:From(entry.Pet) end)
        if ok and item and item.IsHuge then
            local hugeOk, isHuge = pcall(function() return item:IsHuge() end)
            if hugeOk and isHuge then
                return true, petId, "HUGE"
            end
        end
    end

    return false, petId, nil
end

local function isHugeInventoryPet(petData)
    if type(petData) ~= "table" then return false, nil end
    local petId = tostring(petData.id or "")
    if string.find(string.lower(petId), "huge", 1, true) then
        return true, petId
    end
    if PetItem then
        local ok, item = pcall(function() return PetItem:From(petData) end)
        if ok and item and item.IsHuge then
            local hugeOk, isHuge = pcall(function() return item:IsHuge() end)
            if hugeOk and isHuge then
                return true, petId
            end
        end
    end
    return false, petId
end

local function snapshotPreChestHuges()
    local data = Save and Save.Get()
    local roaming = data and data.RoamingPets or {}
    local snapshot = {}
    for index, entry in pairs(roaming) do
        local isRare, rareName = isRarePet(entry)
        if isRare then
            snapshot[index] = rareName
        end
    end
    return snapshot
end

local function findRarePetOnly(preChestSnapshot)
    local data = Save and Save.Get()
    local roaming = data and data.RoamingPets or {}

    for index, entry in pairs(roaming) do
        local isRare, rareName, rareType = isRarePet(entry)
        if isRare then
            if not preChestSnapshot or not preChestSnapshot[index] then
                return index, rareName, true, rareType
            end
        end
    end
    return nil, nil, false, nil
end

--------------------------------------------------------------------------------
-- SECTION 6: ServerHop & Teleport Manager
--------------------------------------------------------------------------------
local SESSION_ENV = (getgenv and getgenv()) or _G
local QUEUE_ON_TELEPORT = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)

local SERVER_HISTORY = {}
if SESSION_ENV and type(SESSION_ENV.EQR_SERVER_HISTORY) == "table" then
    for _, sId in ipairs(SESSION_ENV.EQR_SERVER_HISTORY) do
        if type(sId) == "string" and sId ~= "" then
            table.insert(SERVER_HISTORY, sId)
        end
    end
end

local function syncServerHistorySession()
    while #SERVER_HISTORY > 20 do table.remove(SERVER_HISTORY, 1) end
    if SESSION_ENV then
        local copy = {}
        for idx, id in ipairs(SERVER_HISTORY) do copy[idx] = id end
        SESSION_ENV.EQR_SERVER_HISTORY = copy
    end
end

local function isRecentServer(serverId)
    if not serverId then return false end
    for _, recentId in ipairs(SERVER_HISTORY) do
        if recentId == serverId then return true end
    end
    return false
end

local function rememberServerId(serverId)
    if type(serverId) ~= "string" or serverId == "" then return end
    for idx = #SERVER_HISTORY, 1, -1 do
        if SERVER_HISTORY[idx] == serverId then table.remove(SERVER_HISTORY, idx) end
    end
    table.insert(SERVER_HISTORY, serverId)
    syncServerHistorySession()
end

rememberServerId(game.JobId)

local IS_HOPPING = false

local function setupTeleportContinuation()
    EQR_RUNTIME:AddConnection(player.OnTeleport:Connect(function(teleportState)
        local stateName = tostring(teleportState)
        if string.find(stateName, "Failed", 1, true) then
            IS_HOPPING = false
            return
        end

        if not QUEUE_ON_TELEPORT or not CONFIG.RUNNING then return end

        syncServerHistorySession()
        local modeLit = HttpService:JSONEncode(CONFIG.MODE)
        local histJson = HttpService:JSONEncode(SERVER_HISTORY)
        local histLit = HttpService:JSONEncode(histJson)
        local urlLit = HttpService:JSONEncode(SCRIPT_URL)

        local scriptText = table.concat({
            "local sessionEnv = (getgenv and getgenv()) or _G",
            "sessionEnv.EQR_SESSION_MODE = " .. modeLit,
            "sessionEnv.EQR_SERVER_HISTORY = game:GetService(\"HttpService\"):JSONDecode(" .. histLit .. ")",
            "sessionEnv.EQR_RESUMED_FROM_TELEPORT = true",
            "task.wait(2)",
            "local url = " .. urlLit,
            "local source = nil",
            "for attempt = 1, 5 do",
            "    local ok, res = pcall(function() return game:HttpGet(url) end)",
            "    if ok and res and res ~= '' then source = res; break end",
            "    task.wait(attempt * 1.5)",
            "end",
            "if not source then warn('[EQR Loader] Teleport fetch failed'); return end",
            "local chunk, err = loadstring(source)",
            "if not chunk then warn('[EQR Loader] Compile error: ' .. tostring(err)); return end",
            "pcall(chunk)"
        }, "\n")

        QUEUE_ON_TELEPORT(scriptText)
    end))
end

setupTeleportContinuation()

local function serverHop()
    if IS_HOPPING then return false end
    IS_HOPPING = true

    print("[EQR] Scanning for fresh server...")
    WebhookService:Push("Server Hopping", "Scanning for unvisited servers.", WEBHOOK_COLORS.BLUE)

    local placeId = game.PlaceId
    local currentJobId = game.JobId
    local freshServerIds = {}

    local function fetchServerPage(cursor)
        local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", placeId)
        if cursor then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if ok and body then
            local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(body) end)
            return decodeOk and decoded or nil
        end
        return nil
    end

    local cursor = nil
    local pages = 0
    repeat
        local page = fetchServerPage(cursor)
        if not page then break end
        pages = pages + 1

        for _, server in ipairs(page.data or {}) do
            local sId = server.id
            local playing = tonumber(server.playing) or 0
            local maxP = tonumber(server.maxPlayers) or 0
            if sId and sId ~= currentJobId and playing < maxP then
                if not isRecentServer(sId) then
                    table.insert(freshServerIds, sId)
                end
            end
        end
        cursor = page.nextPageCursor
    until #freshServerIds > 0 or not cursor or pages >= 5

    if #freshServerIds == 0 then
        warn("[EQR] No unvisited servers found. Retrying shortly.")
        IS_HOPPING = false
        return false
    end

    local selected = freshServerIds[math.random(1, #freshServerIds)]
    rememberServerId(selected)

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, selected, player)
    end)

    if not ok then
        warn("[EQR] Teleport failed: " .. tostring(err))
        IS_HOPPING = false
        return false
    end

    return true
end

--------------------------------------------------------------------------------
-- SECTION 7: Authoritative State Machine Engine
--------------------------------------------------------------------------------
local StateMachine = {
    CurrentState = "IDLE",
    StateDetail = "Initializing",
    RunId = EQR_RUNTIME.RunId,
    UIListeners = {}
}

function StateMachine:SetState(state, detail)
    self.CurrentState = state or "IDLE"
    self.StateDetail = detail or ""
    print(string.format("[EQR State] %s: %s", self.CurrentState, self.StateDetail))
    for _, fn in ipairs(self.UIListeners) do
        pcall(fn, self.CurrentState, self.StateDetail)
    end
end

local function getRootPart()
    local character = player.Character or player.CharacterAdded:Wait()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function movePlayer(targetCFrame, statusText)
    local root = getRootPart()
    if not root or not targetCFrame then return false end
    if statusText then StateMachine:SetState("TRAVEL", statusText) end
    root.CFrame = targetCFrame
    task.wait(0.5)
    return (root.Position - targetCFrame.Position).Magnitude < 10
end

local function goToElementalRealm()
    local isThere = false
    pcall(function()
        isThere = MapCmds and MapCmds.GetCurrentZone and MapCmds.GetCurrentZone() == "Elemental Realm"
    end)
    if isThere then return true end

    StateMachine:SetState("TRAVEL", "Teleporting to Elemental Realm")
    pcall(function()
        if MapCmds and MapCmds.Teleport then MapCmds.Teleport("Elemental Realm") end
    end)
    task.wait(1.5)
    return true
end

local function buyAvailableCubeStock()
    if not CONFIG.AUTO_RESTOCK then return 0 end
    local verified = 0
    local slots = {1, 2, 3}

    for _, slot in ipairs(slots) do
        if not CONFIG.AUTO_RESTOCK or not CONFIG.RUNNING then break end
        local invokeOk, _ = pcall(function()
            return ClientNetwork.Invoke("Merchant_RequestPurchase", PET_CUBE_STORE_ID, slot)
        end)
        if invokeOk then
            verified = verified + 1
            STATS.CubesBought = STATS.CubesBought + 1
        end
        task.wait(0.2)
    end
    return verified
end

local function visitShopAndBuy()
    if not CONFIG.AUTO_RESTOCK then return false end
    StateMachine:SetState("SHOP", "Visiting Pet Cube Shop")
    if movePlayer(SHOP_CFRAME, "Moving to Shop") then
        task.wait(0.5)
        buyAvailableCubeStock()
        movePlayer(FARM_ZONE_CFRAME, "Returning to Farm Zone")
        return true
    end
    return false
end

local function breakBossChest(bossChest)
    if not bossChest or not bossChest.Parent then return false end
    local net = ReplicatedStorage:FindFirstChild("Network")
    local damageRemote = net and net:FindFirstChild("Breakables_PlayerDealDamage")
    if not damageRemote then return false end

    movePlayer(BOSS_CHEST_CFRAME, "Approaching Boss Chest")
    StateMachine:SetState("CHEST_BREAK", "Attacking Boss Chest")

    local started = os.clock()
    while os.clock() - started < 30 and bossChest.Parent and CONFIG.RUNNING do
        local root = getRootPart()
        if root then root.CFrame = BOSS_CHEST_CFRAME end

        damageRemote:FireServer(bossChest.Name)
        task.wait(0.2)
    end

    if not bossChest.Parent then
        STATS.ChestsBroken = STATS.ChestsBroken + 1
        movePlayer(BOSS_CHEST_LOOT_CFRAME, "Collecting Loot")
        return true
    end

    return false
end

local function waitForHuge(seconds, preChestSnapshot)
    local deadline = os.clock() + (seconds or 8)
    StateMachine:SetState("HUGE_WAIT", "Scanning for post-chest Huge spawn")

    repeat
        local index, petId, isRareTarget, rareType = findRarePetOnly(preChestSnapshot)
        if index and isRareTarget then
            return index, petId, isRareTarget, rareType
        end
        task.wait(0.2)
    until os.clock() >= deadline or not CONFIG.RUNNING

    return nil, nil, false, nil
end

local function executeMainLoop()
    EQR_RUNTIME:SpawnTask(function()
        local currentRunId = EQR_RUNTIME.RunId

        while isCurrentRun(currentRunId) do
            if not CONFIG.RUNNING then
                StateMachine:SetState("IDLE", "Paused")
                task.wait(0.5)
                continue
            end

            goToElementalRealm()

            if CONFIG.MODE == "HUGE" then
                visitShopAndBuy()
                local bossChest = BossChestService:GetBossChest()
                if bossChest then
                    local preSnapshot = snapshotPreChestHuges()
                    if breakBossChest(bossChest) then
                        local hIdx, hId, hRare, hType = waitForHuge(8, preSnapshot)
                        if hIdx then
                            StateMachine:SetState("HUGE_CATCH", "Attempting Huge Catch: " .. tostring(hId))
                            pcall(function()
                                ClientNetwork.Invoke("RoamingPets_CatchPet", "Ultra Pet Cube", hIdx)
                            end)
                            STATS.PetsCaught = STATS.PetsCaught + 1
                            WebhookService:Push("HUGE CAUGHT!", "Caught **" .. tostring(hId) .. "**!", WEBHOOK_COLORS.GOLD, {}, true)
                        end
                    end
                end
                serverHop()
                task.wait(3)
            else
                -- QUEST MODE
                if CONFIG.AUTO_RESTOCK then visitShopAndBuy() end
                
                local bossChest = CONFIG.AUTO_BREAK and BossChestService:GetBossChest()
                if bossChest then
                    breakBossChest(bossChest)
                end

                if questComplete() then
                    StateMachine:SetState("QUEST_CLAIM", "Redeeming completed quest")
                    pcall(function() ClientNetwork.Invoke("NPC Quests: Redeem", QUEST_ID) end)
                    STATS.QuestsCompleted = STATS.QuestsCompleted + 1
                    task.wait(1.5)
                    continue
                end

                ensureQuestData()

                local roaming = Save and Save.Get() and Save.Get().RoamingPets or {}
                local targetIndex, targetPetId = nil, nil
                local bestDiff = 999999

                for idx, entry in pairs(roaming) do
                    local diff = getCatchDifficulty(entry)
                    if diff < bestDiff then
                        bestDiff = diff
                        targetIndex = idx
                        targetPetId = getRoamingPetId(entry)
                    end
                end

                if targetIndex then
                    StateMachine:SetState("CATCHING", "Catching " .. tostring(targetPetId))
                    local cubeType = CONFIG.USE_ULTRA and "Ultra Pet Cube" or "Pet Cube"
                    local ok, _ = pcall(function()
                        return ClientNetwork.Invoke("RoamingPets_CatchPet", cubeType, targetIndex)
                    end)
                    if ok then
                        STATS.PetsCaught = STATS.PetsCaught + 1
                        STATS.CubesSpent = STATS.CubesSpent + 1
                    end
                else
                    StateMachine:SetState("QUEST_SCAN", "Waiting for roaming targets")
                end

                task.wait(2.5)
            end
        end
    end)
end

--------------------------------------------------------------------------------
-- SECTION 8: UI Engine (Modern Dashboard & Responsive Interface)
--------------------------------------------------------------------------------
local function buildUI()
    local oldGui = playerGui:FindFirstChild("EQR_Pro")
    if oldGui then oldGui:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "EQR_Pro"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui

    local panel = Instance.new("Frame")
    panel.Name = "Main"
    panel.Size = UDim2.fromOffset(560, 480)
    panel.Position = UDim2.new(0.5, -280, 0.5, -240)
    panel.BackgroundColor3 = Color3.fromRGB(15, 17, 26)
    panel.BorderSizePixel = 0
    panel.Active = true
    panel.ClipsDescendants = true
    panel.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = panel

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(88, 101, 242)
    stroke.Thickness = 1.2
    stroke.Parent = panel

    -- Title Bar & Drag Controller
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 40)
    titleBar.BackgroundColor3 = Color3.fromRGB(24, 27, 42)
    titleBar.BorderSizePixel = 0
    titleBar.Parent = panel

    local dragging, dragInput, dragStart, startPos
    EQR_RUNTIME:AddConnection(titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = panel.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end))

    EQR_RUNTIME:AddConnection(titleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))

    EQR_RUNTIME:AddConnection(UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(0, 250, 1, 0)
    titleLabel.Position = UDim2.fromOffset(14, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = "Quest Runner " .. EQR_RUNTIME.Version
    titleLabel.TextColor3 = Color3.fromRGB(240, 243, 255)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 14
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = titleBar

    local statusPill = Instance.new("TextLabel")
    statusPill.Size = UDim2.new(0, 180, 0, 24)
    statusPill.Position = UDim2.new(1, -260, 0.5, -12)
    statusPill.BackgroundColor3 = Color3.fromRGB(35, 39, 62)
    statusPill.Text = "IDLE • Ready"
    statusPill.TextColor3 = Color3.fromRGB(160, 225, 180)
    statusPill.Font = Enum.Font.GothamMedium
    statusPill.TextSize = 11
    statusPill.Parent = titleBar

    local pillCorner = Instance.new("UICorner")
    pillCorner.CornerRadius = UDim.new(0, 6)
    pillCorner.Parent = statusPill

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.fromOffset(26, 24)
    closeBtn.Position = UDim2.new(1, -34, 0.5, -12)
    closeBtn.BackgroundColor3 = Color3.fromRGB(195, 60, 60)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 12
    closeBtn.Parent = titleBar

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 4)
    closeCorner.Parent = closeBtn

    closeBtn.MouseButton1Click:Connect(function()
        CONFIG.RUNNING = false
        saveConfig()
        gui:Destroy()
    end)

    -- Content Dashboard Body
    local body = Instance.new("Frame")
    body.Size = UDim2.new(1, -20, 1, -60)
    body.Position = UDim2.fromOffset(10, 50)
    body.BackgroundTransparency = 1
    body.Parent = panel

    local startBtn = Instance.new("TextButton")
    startBtn.Size = UDim2.new(0.48, 0, 0, 40)
    startBtn.Position = UDim2.fromOffset(0, 10)
    startBtn.BackgroundColor3 = Color3.fromRGB(46, 160, 90)
    startBtn.Text = "START RUNNER"
    startBtn.TextColor3 = Color3.new(1, 1, 1)
    startBtn.Font = Enum.Font.GothamBold
    startBtn.TextSize = 13
    startBtn.Parent = body

    local startCorner = Instance.new("UICorner")
    startCorner.CornerRadius = UDim.new(0, 8)
    startCorner.Parent = startBtn

    startBtn.MouseButton1Click:Connect(function()
        CONFIG.RUNNING = not CONFIG.RUNNING
        startBtn.Text = CONFIG.RUNNING and "PAUSE RUNNER" or "START RUNNER"
        startBtn.BackgroundColor3 = CONFIG.RUNNING and Color3.fromRGB(190, 70, 60) or Color3.fromRGB(46, 160, 90)
        saveConfig()
    end)

    local modeBtn = Instance.new("TextButton")
    modeBtn.Size = UDim2.new(0.48, 0, 0, 40)
    modeBtn.Position = UDim2.new(0.52, 0, 0, 10)
    modeBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    modeBtn.Text = "MODE: " .. CONFIG.MODE
    modeBtn.TextColor3 = Color3.new(1, 1, 1)
    modeBtn.Font = Enum.Font.GothamBold
    modeBtn.TextSize = 13
    modeBtn.Parent = body

    local modeCorner = Instance.new("UICorner")
    modeCorner.CornerRadius = UDim.new(0, 8)
    modeCorner.Parent = modeBtn

    modeBtn.MouseButton1Click:Connect(function()
        CONFIG.MODE = CONFIG.MODE == "QUEST" and "HUGE" or "QUEST"
        modeBtn.Text = "MODE: " .. CONFIG.MODE
        saveConfig()
    end)

    -- Stats Log Display
    local statsCard = Instance.new("Frame")
    statsCard.Size = UDim2.new(1, 0, 0, 360)
    statsCard.Position = UDim2.fromOffset(0, 60)
    statsCard.BackgroundColor3 = Color3.fromRGB(20, 23, 36)
    statsCard.Parent = body

    local cardCorner = Instance.new("UICorner")
    cardCorner.CornerRadius = UDim.new(0, 8)
    cardCorner.Parent = statsCard

    local statsLabel = Instance.new("TextLabel")
    statsLabel.Size = UDim2.new(1, -20, 1, -20)
    statsLabel.Position = UDim2.fromOffset(10, 10)
    statsLabel.BackgroundTransparency = 1
    statsLabel.Text = "Initializing UI..."
    statsLabel.TextColor3 = Color3.fromRGB(200, 210, 235)
    statsLabel.Font = Enum.Font.Code
    statsLabel.TextSize = 12
    statsLabel.TextXAlignment = Enum.TextXAlignment.Left
    statsLabel.TextYAlignment = Enum.TextYAlignment.Top
    statsLabel.Parent = statsCard

    table.insert(StateMachine.UIListeners, function(state, detail)
        statusPill.Text = string.upper(state) .. " • " .. string.sub(detail, 1, 18)
        statsLabel.Text = string.format(
            "================ SESSION DASHBOARD ================\n" ..
            "State: %s (%s)\n" ..
            "Runtime: %02d:%02d:%02d\n\n" ..
            "Quests Completed: %d\n" ..
            "Pets Caught:      %d\n" ..
            "Chests Broken:    %d\n" ..
            "Cubes Spent:      %d\n" ..
            "Normal Cubes:     %d\n" ..
            "Ultra Cubes:      %d\n" ..
            "Servers History:  %d/20\n" ..
            "==================================================",
            state, detail,
            math.floor((os.time() - STATS.StartTime)/3600),
            math.floor(((os.time() - STATS.StartTime)%3600)/60),
            (os.time() - STATS.StartTime)%60,
            STATS.QuestsCompleted,
            STATS.PetsCaught,
            STATS.ChestsBroken,
            STATS.CubesSpent,
            getCubeCount(false),
            getCubeCount(true),
            #SERVER_HISTORY
        )
    end)
end

--------------------------------------------------------------------------------
-- SECTION 9: Main Execution Entrypoint
--------------------------------------------------------------------------------
local function main()
    buildUI()
    executeMainLoop()
    print("[EQR " .. EQR_RUNTIME.Version .. "] Architecture Refactor loaded cleanly.")
end

local ok, err = xpcall(main, debug.traceback)
if not ok then
    warn("[EQR Critical Fatal Error]: " .. tostring(err))
end
