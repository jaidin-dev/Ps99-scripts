goalsLabel.BackgroundTransparency = 1
goalsLabel.Font = Enum.Font.Gotham
goalsLabel.TextSize = FS
goalsLabel.TextColor3 = Color3.fromRGB(200, 210, 230)
goalsLabel.TextXAlignment = Enum.TextXAlignment.Left
goalsLabel.TextYAlignment = Enum.TextYAlignment.Top
goalsLabel.TextWrapped = true
goalsLabel.Text = "Loading quests..."
goalsLabel.ZIndex = 4
goalsLabel.Parent = questCard
GUI_REF.goalsLabel = goalsLabel

local function renderGoals()
    local quest = getQuestData()
    if not quest or not quest.Quests then
        goalsLabel.Text = "Waiting for quests..."
        return
    end
    local lines = {}
    for i = 1, 3 do
        local goal = quest.Quests[i]
        if goal then
            local prog = goal.Progress or 0
            local total = goal.Amount or 0
            local pct = total > 0 and math.floor((prog / total) * 100) or 0
            local bar = pct >= 100 and "[DONE]" or (pct >= 50 and "[HALF]" or "[...]")
            lines[#lines + 1] = string.format("%s %s: %d/%d (%d%%)", bar, goal.PetID or "Unknown", prog, total, pct)
        end
    end
    goalsLabel.Text = #lines > 0 and table.concat(lines, "\n") or "No quests"
end

