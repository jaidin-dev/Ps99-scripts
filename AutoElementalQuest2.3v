setStatus = function(msg)
    CURRENT_STAGE_DETAIL = tostring(msg)

    if statusLabel and statusLabel.Parent then
        statusLabel.Text = "Status: " .. tostring(msg)
    end

    if GUI_REF.stageDetail and GUI_REF.stageDetail.Parent then
        GUI_REF.stageDetail.Text = tostring(msg)
    end
end

setStage = function(stageName, detail)
    CURRENT_STAGE = tostring(stageName or "WORKING")
    CURRENT_STAGE_DETAIL = tostring(detail or CURRENT_STAGE_DETAIL or "")

    if GUI_REF.stageName and GUI_REF.stageName.Parent then
        GUI_REF.stageName.Text = CURRENT_STAGE
    end
    if GUI_REF.stageDetail and GUI_REF.stageDetail.Parent then
        GUI_REF.stageDetail.Text = CURRENT_STAGE_DETAIL
    end
    if GUI_REF.compactStatusLabel and GUI_REF.compactStatusLabel.Parent then
        GUI_REF.compactStatusLabel.Text = CURRENT_STAGE
    end

    setStatus(CURRENT_STAGE_DETAIL)
end

