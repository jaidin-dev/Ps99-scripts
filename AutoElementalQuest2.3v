-- CREATE GUI IMMEDIATELY TO GUARANTEE IT APPEARS
local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
local mobile = vp.X < 900 or vp.Y < 500
local PW = mobile and 350 or 570
local PH = mobile and 470 or 610
local FS = mobile and 10 or 12
