        breakToggle.Text = "Chest Break: " .. (CONFIG.AUTO_BREAK and "ON" or "OFF")
        breakToggle.BackgroundColor3 = CONFIG.AUTO_BREAK and Color3.fromRGB(40, 50, 75) or Color3.fromRGB(25, 28, 40)
        breakToggle.TextColor3 = CONFIG.AUTO_BREAK and Color3.fromRGB(160, 220, 255) or Color3.fromRGB(150, 155, 170)
        saveConfig()
    end)

    local shopToggle = Instance.new("TextButton")
    shopToggle.Size = UDim2.new(0.47, 0, 0, 24)
    shopToggle.Position = UDim2.new(0.53, 0, 0, 84)
