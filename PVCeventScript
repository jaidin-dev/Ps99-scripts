createToggle("💰 Auto-Collect Money Pads", function(active)
    _G.AutoCollectMoneyPads = active
    if active then
        setStatus("Auto-collecting pads...")
        task.spawn(function()
            while _G.AutoCollectMoneyPads do
                local localInstance = ClientTowerDefense:GetLocal()
                if localInstance then
                    local instId = tostring(localInstance.Id)
                    local plotFolder = workspace:FindFirstChild("__THINGS")
                        and workspace.__THINGS:FindFirstChild("Plots")
                        and workspace.__THINGS.Plots:FindFirstChild(instId)

                    local pillars = plotFolder and plotFolder:FindFirstChild("Interactable") and plotFolder.Interactable:FindFirstChild("Pillars")
                    local player = Players.LocalPlayer
                    local character = player and player.Character
                    local rootPart = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))

                    if pillars and rootPart then
                        local origCF = rootPart.CFrame

                        for _, pillarName in ipairs({"1", "2", "3", "4", "5", "6", "7"}) do
                            if not _G.AutoCollectMoneyPads then break end
                            local pillar = pillars:FindFirstChild(pillarName)
                            local pad = pillar and pillar:FindFirstChild("Pad")
                            local claimPart = pad and (pad:FindFirstChild("Claim") or pad:FindFirstChild("ClaimBase"))

                            if claimPart then
                                pcall(function() PadPress.Press(claimPart) end)
                                local padCF = claimPart.CFrame * CFrame.new(0, 1.2, 0)
                                for step = 1, 3 do
                                    rootPart.CFrame = padCF * CFrame.new(0, 0, (step % 2 == 0) and 0.1 or -0.1)
                                    task.wait(0.08)
                                end
                            end
                        end

                        local things = workspace:FindFirstChild("__THINGS")
                        if things and things:FindFirstChild("Orbs") then
                            local ids = {}
                            for _, orb in ipairs(things.Orbs:GetChildren()) do table.insert(ids, orb.Name) end
                            if #ids > 0 then pcall(function() Network.Fire("Orbs: Collect", ids) end) end
                        end

                        rootPart.CFrame = origCF
                    end
                end
                task.wait(2)
            end
        end)
    else
        setStatus("Pad collector stopped.")
    end
end)

