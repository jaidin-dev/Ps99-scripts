local function cleanAndDelete(inst)
    pcall(function()
        if inst:IsA("ParticleEmitter") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") or inst:IsA("Trail") or inst:IsA("Beam") then
            inst:Destroy()
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            inst:Destroy()
        elseif inst:IsA("Sound") and inst.Name ~= "UI" then
            inst:Destroy()
        elseif inst:IsA("BasePart") then
            inst.CastShadow = false
            inst.Reflectance = 0
            if inst.Material ~= Enum.Material.SmoothPlastic then
                inst.Material = Enum.Material.SmoothPlastic
            end
        end
    end)
end

for _, descendant in ipairs(Workspace:GetDescendants()) do
    cleanAndDelete(descendant)
end

Workspace.DescendantAdded:Connect(function(descendant)
    cleanAndDelete(descendant)
